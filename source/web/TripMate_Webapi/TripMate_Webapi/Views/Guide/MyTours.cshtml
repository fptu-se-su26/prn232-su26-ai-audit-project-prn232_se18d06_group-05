@model IReadOnlyList<TripMate_WebAPI.DTOs.Tour.Responses.MyTourDashboardDto>
@using System.Text.Json
@{
    ViewData["Title"] = "My Tours";
    ViewData["ActivePage"] = "MyTours";
    ViewData["TurboCacheControl"] = "no-cache";
    Layout = "_GuideLayout";
    var serializedTours = JsonSerializer.Serialize(Model ?? [], new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    });
}

<script>
    window.myToursInitialData = @Html.Raw(serializedTours);

    function myToursApp(initialTours) {
        return {
            tours: initialTours || [],
            filter: 'all',
            searchQuery: '',
            sortBy: 'updated',
            openDropdown: null,
            previewTour: null,
            previewActiveDay: 1,
            previewDescriptionExpanded: false,
            qualityTour: null,
            actionDialogOpen: false,
            pendingAction: null,
            isProcessingAction: false,
            failedImages: {},
            statusTabs: [
                { id: 'all', label: 'All' },
                { id: 'published', label: 'Published' },
                { id: 'draft', label: 'Drafts' },
                { id: 'hidden', label: 'Hidden' },
                { id: 'needs-schedule', label: 'Needs schedule' }
            ],

            get filteredTours() {
                const query = this.searchQuery.trim().toLocaleLowerCase();
                return this.tours
                    .filter(tour => this.matchesFilter(tour)
                        && (!query || `${tour.name} ${tour.city} ${tour.schedule?.durationLabel || ''}`
                            .toLocaleLowerCase().includes(query)))
                    .sort((a, b) => {
                        if (this.sortBy === 'bookings') return b.bookingCount - a.bookingCount;
                        if (this.sortBy === 'revenue') return b.revenue - a.revenue;
                        if (this.sortBy === 'quality') return b.completenessScore - a.completenessScore;
                        if (this.sortBy === 'name') return (a.name || '').localeCompare(b.name || '');
                        return new Date(b.updatedAt) - new Date(a.updatedAt);
                    });
            },
            get totalBookings() {
                return this.tours.reduce((sum, tour) => sum + tour.bookingCount, 0);
            },
            get totalRevenue() {
                return this.tours.reduce((sum, tour) => sum + Number(tour.revenue || 0), 0);
            },
            get totalReviews() {
                return this.tours.reduce((sum, tour) => sum + tour.reviewCount, 0);
            },
            get needsScheduleCount() {
                return this.tours.filter(tour => !tour.schedule?.isConfigured).length;
            },
            get portfolioRating() {
                const rated = this.tours.filter(tour => tour.averageRating && tour.reviewCount);
                if (!rated.length) return null;
                return (rated.reduce((sum, tour) => sum + tour.averageRating * tour.reviewCount, 0)
                    / rated.reduce((sum, tour) => sum + tour.reviewCount, 0)).toFixed(1);
            },

            matchesFilter(tour) {
                if (this.filter === 'all') return true;
                if (this.filter === 'needs-schedule') return !tour.schedule?.isConfigured;
                return tour.publicationStatus === this.filter;
            },
            countByStatus(status) {
                if (status === 'all') return this.tours.length;
                if (status === 'needs-schedule') return this.needsScheduleCount;
                return this.tours.filter(tour => tour.publicationStatus === status).length;
            },
            formatCurrency(value) {
                return new Intl.NumberFormat('vi-VN', {
                    style: 'currency', currency: 'VND', maximumFractionDigits: 0
                }).format(Number(value || 0));
            },
            formatDate(value) {
                if (!value) return 'recently';
                const date = new Date(value);
                if (Number.isNaN(date.getTime())) return 'recently';
                return new Intl.DateTimeFormat('en-GB', {
                    day: 'numeric', month: 'short', year: 'numeric'
                }).format(date);
            },
            statusLabel(status) {
                return ({ published: 'Published', draft: 'Draft', hidden: 'Hidden' })[status] || 'Hidden';
            },
            statusClass(status) {
                if (status === 'published') return 'bg-white/95 text-green-700';
                if (status === 'draft') return 'bg-amber-50 text-amber-700';
                return 'bg-slate-900/80 text-white';
            },
            durationLabel(tour) {
                return tour?.schedule?.durationLabel || `${tour?.duration || 0} hours`;
            },
            timeRangeLabel(tour) {
                return tour?.schedule?.timeRangeLabel || 'Time not set';
            },
            scheduleTypeLabel(tour) {
                return tour?.schedule?.durationType === 'multi_day' ? 'Multi-day tour' : 'Same-day tour';
            },
            get activePreviewDay() {
                const days = this.previewTour?.itineraryDays || [];
                return days.find(day => day.dayNumber === this.previewActiveDay) || days[0] || null;
            },
            openTourPreview(tour) {
                this.openDropdown = null;
                this.previewTour = tour;
                this.previewActiveDay = tour?.itineraryDays?.[0]?.dayNumber || 1;
                this.previewDescriptionExpanded = false;
                document.body.style.overflow = 'hidden';
                this.$nextTick(() => document.querySelector('[data-tour-preview-close]')?.focus());
            },
            closeTourPreview() {
                this.previewTour = null;
                this.previewDescriptionExpanded = false;
                document.body.style.overflow = '';
            },
            itineraryTime(item) {
                if (!item) return 'Time TBD';
                if (item.startTime && item.endTime) return `${item.startTime}–${item.endTime}`;
                return item.startTime || item.endTime || 'Time TBD';
            },
            priceCaption(tour) {
                if (!tour) return '';
                const included = `Includes ${tour.includedGuests} ${tour.includedGuests === 1 ? 'guest' : 'guests'}`;
                return tour.additionalGuestFee > 0 && tour.maxGuests > tour.includedGuests
                    ? `${included} · +${this.formatCurrency(tour.additionalGuestFee)}/extra guest`
                    : included;
            },
            closeOverlays() {
                this.openDropdown = null;
                this.closeTourPreview();
                this.qualityTour = null;
                if (!this.isProcessingAction) this.actionDialogOpen = false;
            },
            requestAction(type, tour) {
                this.openDropdown = null;
                const active = tour.publicationStatus === 'published';
                const copy = {
                    toggle: {
                        title: active ? 'Hide this tour?' : 'Publish this tour?',
                        description: active
                            ? 'Travelers will no longer be able to make new bookings.'
                            : 'This tour will be visible and bookable again.',
                        confirmLabel: active ? 'Hide tour' : 'Publish tour'
                    },
                    duplicate: {
                        title: 'Create a draft copy?',
                        description: 'A separate draft will be created for you to review and edit.',
                        confirmLabel: 'Create copy'
                    },
                    delete: {
                        title: 'Remove this tour?',
                        description: 'Tours with booking history are archived. Tours without bookings are permanently deleted.',
                        confirmLabel: 'Remove tour'
                    }
                }[type];
                this.pendingAction = { type, tour, ...copy };
                this.actionDialogOpen = true;
            },
            async confirmAction() {
                if (!this.pendingAction || this.isProcessingAction) return;
                const action = this.pendingAction;
                const endpoints = {
                    toggle: [`/ToggleTourStatus/${action.tour.id}`, 'PATCH'],
                    duplicate: [`/DuplicateTour/${action.tour.id}`, 'POST'],
                    delete: [`/DeleteTour/${action.tour.id}`, 'DELETE']
                };
                this.isProcessingAction = true;
                try {
                    const [url, method] = endpoints[action.type];
                    const response = await fetch(url, { method });
                    const result = await response.json();
                    if (!response.ok || !result.success) {
                        throw new Error(result.message || 'The action could not be completed.');
                    }

                    if (action.type === 'toggle') {
                        action.tour.publicationStatus = action.tour.publicationStatus === 'published'
                            ? 'hidden'
                            : 'published';
                        action.tour.isActive = action.tour.publicationStatus === 'published';
                        action.tour.updatedAt = new Date().toISOString();
                    } else if (action.type === 'delete') {
                        if (result.data?.outcome === 'archived') {
                            action.tour.publicationStatus = 'hidden';
                            action.tour.isActive = false;
                        } else {
                            this.tours = this.tours.filter(tour => tour.id !== action.tour.id);
                        }
                    } else {
                        this.tours.unshift({
                            ...action.tour,
                            id: result.data.id,
                            name: `${action.tour.name} (Copy)`,
                            publicationStatus: 'draft',
                            isActive: false,
                            bookingCount: 0,
                            completedBookingCount: 0,
                            revenue: 0,
                            averageRating: null,
                            reviewCount: 0,
                            updatedAt: new Date().toISOString()
                        });
                    }

                    this.actionDialogOpen = false;
                    showToast('success', result.message || 'Tour updated.');
                } catch (error) {
                    showToast('error', error.message || 'Please try again.');
                } finally {
                    this.isProcessingAction = false;
                }
            }
        };
    }
</script>

<div x-data="myToursApp(window.myToursInitialData)"
     @@keydown.escape.window="closeOverlays()"
     class="space-y-5">
    <header class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <p class="text-xs font-bold uppercase tracking-[0.18em] text-primary">Tour management</p>
            <h1 class="mt-0.5 text-2xl font-black tracking-tight text-slate-950">My Tours</h1>
            <p class="mt-1 text-sm text-slate-500">Manage schedules, listing quality, and performance.</p>
        </div>
        <a href="/Guide/CreateTour" data-turbo="false"
           class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-primary-dark focus:outline-none focus:ring-4 focus:ring-orange-200">
            <span class="material-symbols-outlined text-[18px]">add</span>
            Create Tour
        </a>
    </header>

    <section class="grid grid-cols-2 gap-3 xl:grid-cols-4" aria-label="Tour performance summary">
        <article class="rounded-xl border border-slate-100 bg-white p-3 shadow-sm">
            <div class="flex items-center justify-between">
                <span class="text-[11px] font-bold uppercase tracking-wide text-slate-500">Published</span>
                <span class="material-symbols-outlined text-[19px] text-green-500">visibility</span>
            </div>
            <p class="mt-1.5 text-xl font-black text-slate-950" x-text="countByStatus('published')"></p>
            <p class="text-xs text-slate-500"
               x-text="needsScheduleCount ? `${needsScheduleCount} need schedule details` : 'All schedules configured'"></p>
        </article>
        <article class="rounded-xl border border-slate-100 bg-white p-3 shadow-sm">
            <div class="flex items-center justify-between">
                <span class="text-[11px] font-bold uppercase tracking-wide text-slate-500">Bookings</span>
                <span class="material-symbols-outlined text-[19px] text-blue-500">confirmation_number</span>
            </div>
            <p class="mt-1.5 text-xl font-black text-slate-950" x-text="totalBookings"></p>
            <p class="text-xs text-slate-500">Active and completed</p>
        </article>
        <article class="rounded-xl border border-slate-100 bg-white p-3 shadow-sm">
            <div class="flex items-center justify-between">
                <span class="text-[11px] font-bold uppercase tracking-wide text-slate-500">Net earnings</span>
                <span class="material-symbols-outlined text-[19px] text-emerald-500">payments</span>
            </div>
            <p class="mt-1.5 text-lg font-black text-slate-950" x-text="formatCurrency(totalRevenue)"></p>
            <p class="text-xs text-slate-500">Completed bookings</p>
        </article>
        <article class="rounded-xl border border-slate-100 bg-white p-3 shadow-sm">
            <div class="flex items-center justify-between">
                <span class="text-[11px] font-bold uppercase tracking-wide text-slate-500">Average rating</span>
                <span class="material-symbols-outlined text-[19px] text-amber-500">star</span>
            </div>
            <p class="mt-1.5 text-xl font-black text-slate-950" x-text="portfolioRating || '—'"></p>
            <p class="text-xs text-slate-500"
               x-text="totalReviews ? `${totalReviews} verified review${totalReviews === 1 ? '' : 's'}` : 'No reviews yet'"></p>
        </article>
    </section>

    <section class="rounded-2xl border border-slate-100 bg-white p-3 shadow-sm">
        <div class="grid gap-3 xl:grid-cols-[minmax(260px,1fr)_auto_200px] xl:items-center">
            <label class="relative min-w-0">
                <span class="sr-only">Search tours</span>
                <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400">search</span>
                <input x-model.debounce.200ms="searchQuery" type="search"
                       placeholder="Search by tour, city, or duration"
                       class="w-full rounded-xl border border-slate-200 bg-slate-50 py-2.5 pl-11 pr-4 text-sm outline-none transition focus:border-primary focus:bg-white focus:ring-4 focus:ring-orange-100">
            </label>
            <div class="flex gap-1 overflow-x-auto rounded-xl bg-slate-50 p-1"
                 role="group" aria-label="Filter tours">
                <template x-for="tab in statusTabs" :key="tab.id">
                    <button type="button" @@click="filter = tab.id"
                            :aria-pressed="filter === tab.id"
                            :class="filter === tab.id ? 'bg-white text-slate-950 shadow-sm' : 'text-slate-500 hover:text-slate-800'"
                            class="inline-flex items-center gap-2 whitespace-nowrap rounded-lg px-3 py-2 text-xs font-bold transition">
                        <span x-text="tab.label"></span>
                        <span class="rounded-full bg-slate-100 px-1.5 py-0.5 text-[11px]"
                              x-text="countByStatus(tab.id)"></span>
                    </button>
                </template>
            </div>
            <label>
                <span class="sr-only">Sort tours</span>
                <select x-model="sortBy"
                        class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-semibold text-slate-700 outline-none focus:border-primary">
                    <option value="updated">Recently updated</option>
                    <option value="bookings">Most booked</option>
                    <option value="revenue">Highest earnings</option>
                    <option value="quality">Best listing quality</option>
                    <option value="name">Name A–Z</option>
                </select>
            </label>
        </div>
    </section>

    <section x-show="filteredTours.length"
             class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3"
             aria-live="polite">
        <template x-for="tour in filteredTours" :key="tour.id">
            <article class="relative overflow-visible rounded-2xl border border-slate-100 bg-white shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg">
                <button type="button" @@click="openTourPreview(tour)"
                        :aria-label="`Preview ${tour.name || 'untitled tour'}`"
                        class="group relative block aspect-[16/7] w-full overflow-hidden rounded-t-2xl bg-gradient-to-br from-orange-100 via-amber-50 to-slate-100 text-left focus:outline-none focus:ring-4 focus:ring-inset focus:ring-orange-300">
                    <div x-show="!tour.imageUrl || failedImages[tour.id]"
                         class="absolute inset-0 flex flex-col items-center justify-center text-orange-400">
                        <span class="material-symbols-outlined text-4xl">landscape</span>
                        <span class="mt-1 text-xs font-bold">Add a cover photo</span>
                    </div>
                    <img x-show="tour.imageUrl && !failedImages[tour.id]"
                         :src="tour.imageUrl" :alt="tour.name"
                         @@error="failedImages[tour.id] = true"
                         class="h-full w-full object-cover transition duration-500 group-hover:scale-105">
                    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/65 via-transparent to-slate-950/5"></div>
                    <span class="absolute left-3 top-3 inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[11px] font-black shadow-sm"
                          :class="statusClass(tour.publicationStatus)">
                        <span class="h-1.5 w-1.5 rounded-full bg-current"></span>
                        <span x-text="statusLabel(tour.publicationStatus)"></span>
                    </span>
                    <span x-show="tour.city"
                          class="absolute bottom-3 left-3 inline-flex items-center gap-1 rounded-lg bg-white/90 px-2 py-1 text-xs font-bold text-slate-700 backdrop-blur">
                        <span class="material-symbols-outlined text-[14px] text-primary">location_on</span>
                        <span x-text="tour.city"></span>
                    </span>
                    <span class="absolute bottom-3 right-3 inline-flex items-center gap-1 rounded-lg bg-slate-950/75 px-2 py-1 text-[11px] font-bold text-white backdrop-blur">
                        <span class="material-symbols-outlined text-[14px]">visibility</span>
                        Preview
                    </span>
                </button>

                <div class="p-3.5">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0">
                            <h2 class="line-clamp-1 text-[17px] font-black text-slate-950"
                                x-text="tour.name || 'Untitled draft'"></h2>
                            <p class="text-xs font-medium text-slate-500"
                               x-text="`Updated ${formatDate(tour.updatedAt)}`"></p>
                        </div>
                        <div class="relative">
                            <button type="button"
                                    @@click.stop="openDropdown = openDropdown === tour.id ? null : tour.id"
                                    :aria-expanded="openDropdown === tour.id"
                                    :aria-label="`More actions for ${tour.name}`"
                                    class="flex h-9 w-9 items-center justify-center rounded-full text-slate-500 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-orange-300">
                                <span class="material-symbols-outlined">more_vert</span>
                            </button>
                            <div x-show="openDropdown === tour.id" @@click.outside="openDropdown = null"
                                 x-transition.opacity style="display:none"
                                 class="absolute right-0 top-10 z-40 w-48 overflow-hidden rounded-xl border border-slate-100 bg-white py-1 shadow-xl">
                                <a :href="`/Guide/CreateTour?id=${tour.id}`" data-turbo="false"
                                   class="flex items-center gap-2 px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">
                                    <span class="material-symbols-outlined text-[18px]">edit</span>
                                    <span x-text="tour.publicationStatus === 'draft' ? 'Continue editing' : 'Edit tour'"></span>
                                </a>
                                <button x-show="tour.publicationStatus !== 'draft'" type="button"
                                        @@click="requestAction('toggle', tour)"
                                        class="flex w-full items-center gap-2 px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">
                                    <span class="material-symbols-outlined text-[18px]"
                                          x-text="tour.publicationStatus === 'published' ? 'visibility_off' : 'visibility'"></span>
                                    <span x-text="tour.publicationStatus === 'published' ? 'Hide tour' : 'Publish tour'"></span>
                                </button>
                                <button type="button" @@click="requestAction('duplicate', tour)"
                                        class="flex w-full items-center gap-2 px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">
                                    <span class="material-symbols-outlined text-[18px]">content_copy</span>
                                    Duplicate
                                </button>
                                <button type="button" @@click="requestAction('delete', tour)"
                                        class="flex w-full items-center gap-2 border-t border-slate-100 px-4 py-2.5 text-sm font-bold text-red-600 hover:bg-red-50">
                                    <span class="material-symbols-outlined text-[18px]">delete</span>
                                    Remove
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3 grid grid-cols-3 divide-x divide-slate-200 rounded-xl bg-slate-50 py-2.5 text-center">
                        <div>
                            <p class="text-sm font-black text-slate-900" x-text="tour.bookingCount"></p>
                            <p class="text-[10px] font-bold uppercase tracking-wide text-slate-500">Bookings</p>
                        </div>
                        <div>
                            <p class="text-sm font-black text-slate-900"
                               x-text="tour.reviewCount ? Number(tour.averageRating).toFixed(1) : '—'"></p>
                            <p class="text-[10px] font-bold uppercase tracking-wide text-slate-500">Rating</p>
                        </div>
                        <button type="button" @@click="qualityTour = tour"
                                class="focus:outline-none focus:ring-2 focus:ring-inset focus:ring-orange-300"
                                :aria-label="`View listing quality for ${tour.name}`">
                            <p class="text-sm font-black"
                               :class="tour.completenessScore === 100 ? 'text-green-600' : 'text-amber-600'"
                               x-text="`${tour.completenessScore}%`"></p>
                            <p class="text-[10px] font-bold uppercase tracking-wide text-slate-500">Quality</p>
                        </button>
                    </div>

                    <div class="mt-3 grid grid-cols-3 gap-2 text-[11px] font-semibold text-slate-600">
                        <span class="inline-flex min-w-0 items-center gap-1" :title="durationLabel(tour)">
                            <span class="material-symbols-outlined shrink-0 text-[15px]">date_range</span>
                            <span class="truncate" x-text="durationLabel(tour)"></span>
                        </span>
                        <span class="inline-flex min-w-0 items-center gap-1"
                              :class="tour.schedule?.isConfigured ? 'text-slate-600' : 'text-amber-700'"
                              :title="timeRangeLabel(tour)">
                            <span class="material-symbols-outlined shrink-0 text-[15px]">schedule</span>
                            <span class="truncate" x-text="timeRangeLabel(tour)"></span>
                        </span>
                        <span class="inline-flex min-w-0 items-center gap-1">
                            <span class="material-symbols-outlined shrink-0 text-[15px]">group</span>
                            <span class="truncate" x-text="`Up to ${tour.maxGuests}`"></span>
                        </span>
                    </div>

                    <div class="mt-3 flex items-end justify-between gap-3 border-t border-slate-100 pt-2.5">
                        <div class="min-w-0">
                            <p class="text-[17px] font-black text-primary" x-text="formatCurrency(tour.price)"></p>
                            <p class="truncate text-[10px] font-medium text-slate-500" x-text="priceCaption(tour)"></p>
                        </div>
                        <a :href="`/Guide/CreateTour?id=${tour.id}`" data-turbo="false"
                           class="inline-flex shrink-0 items-center gap-1 rounded-lg bg-slate-950 px-3 py-2 text-xs font-bold text-white transition hover:bg-primary focus:outline-none focus:ring-4 focus:ring-orange-200">
                            <span class="material-symbols-outlined text-[15px]">edit</span>
                            <span x-text="tour.publicationStatus === 'draft' ? 'Complete' : 'Edit'"></span>
                        </a>
                    </div>
                </div>
            </article>
        </template>
    </section>

    <section x-show="!filteredTours.length"
             class="flex flex-col items-center justify-center rounded-2xl border border-slate-100 bg-white px-6 py-14 text-center"
             style="display:none">
        <span class="material-symbols-outlined text-5xl text-slate-300"
              x-text="tours.length ? 'search_off' : 'map'"></span>
        <h2 class="mt-3 text-lg font-black text-slate-900"
            x-text="tours.length ? 'No tours match these filters' : 'Create your first tour'"></h2>
        <p class="mt-1 text-sm text-slate-500"
           x-text="tours.length ? 'Try another status or search term.' : 'Turn your local knowledge into a bookable experience.'"></p>
        <button x-show="tours.length" type="button"
                @@click="searchQuery = ''; filter = 'all'"
                class="mt-4 rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-bold text-slate-700">
            Clear filters
        </button>
        <a x-show="!tours.length" href="/Guide/CreateTour" data-turbo="false"
           class="mt-4 inline-flex rounded-xl bg-primary px-5 py-3 text-sm font-bold text-white">
            Create Tour
        </a>
    </section>

    <div x-show="qualityTour" class="fixed inset-0 z-[95] flex items-center justify-center p-4"
         style="display:none" role="dialog" aria-modal="true" aria-labelledby="quality-dialog-title">
        <div class="absolute inset-0 bg-slate-950/55 backdrop-blur-sm" @@click="qualityTour = null"></div>
        <section class="relative w-full max-w-md rounded-2xl bg-white p-6 shadow-2xl">
            <button type="button" @@click="qualityTour = null"
                    class="absolute right-4 top-4 flex h-9 w-9 items-center justify-center rounded-full text-slate-500 hover:bg-slate-100"
                    aria-label="Close listing quality">
                <span class="material-symbols-outlined">close</span>
            </button>
            <p class="text-xs font-bold uppercase tracking-wider text-primary">Listing quality</p>
            <h2 id="quality-dialog-title" class="mt-1 pr-10 text-xl font-black text-slate-950"
                x-text="qualityTour?.name || 'Untitled draft'"></h2>
            <div class="mt-5 flex items-center gap-4">
                <div class="flex h-16 w-16 items-center justify-center rounded-full bg-orange-50 text-lg font-black text-primary"
                     x-text="`${qualityTour?.completenessScore || 0}%`"></div>
                <p class="flex-1 text-sm leading-6 text-slate-500"
                   x-text="qualityTour?.completenessScore === 100
                       ? 'This listing contains all recommended information.'
                       : 'Complete the items below to help travelers book with confidence.'"></p>
            </div>
            <ul class="mt-5 space-y-2">
                <template x-for="item in qualityTour?.missingQualityItems || []" :key="item">
                    <li class="flex items-start gap-2 rounded-xl bg-amber-50 px-3 py-2.5 text-sm font-semibold text-amber-800">
                        <span class="material-symbols-outlined text-[18px]">error</span>
                        <span x-text="item"></span>
                    </li>
                </template>
                <li x-show="qualityTour?.completenessScore === 100"
                    class="flex items-center gap-2 rounded-xl bg-green-50 px-3 py-3 text-sm font-semibold text-green-700">
                    <span class="material-symbols-outlined text-[18px]">check_circle</span>
                    All recommended details are complete.
                </li>
            </ul>
            <a :href="`/Guide/CreateTour?id=${qualityTour?.id}`" data-turbo="false"
               class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-slate-950 px-4 py-3 text-sm font-bold text-white hover:bg-primary">
                <span class="material-symbols-outlined text-[18px]">edit</span>
                Improve listing
            </a>
        </section>
    </div>

    <div x-show="previewTour" class="fixed inset-0 z-[90] flex items-center justify-center p-3 sm:p-5"
         style="display:none" role="dialog" aria-modal="true" aria-labelledby="tour-preview-title">
        <div class="absolute inset-0 bg-slate-950/60 backdrop-blur-sm" @@click="closeTourPreview()"></div>
        <article class="relative flex max-h-[92vh] w-full max-w-5xl flex-col overflow-hidden rounded-2xl bg-white shadow-2xl sm:rounded-3xl">
            <header class="flex shrink-0 items-center justify-between gap-4 border-b border-slate-100 bg-white px-4 py-3.5 sm:px-6">
                <div class="min-w-0">
                    <div class="flex items-center gap-2">
                        <span class="text-[10px] font-black uppercase tracking-[0.16em] text-primary">Traveler preview</span>
                        <span class="rounded-full px-2 py-0.5 text-[9px] font-black uppercase"
                              :class="statusClass(previewTour?.publicationStatus)"
                              x-text="statusLabel(previewTour?.publicationStatus)"></span>
                    </div>
                    <h2 id="tour-preview-title" class="mt-0.5 truncate text-base font-black text-slate-950 sm:text-lg"
                        x-text="previewTour?.name || 'Untitled draft'"></h2>
                </div>
                <button type="button" data-tour-preview-close @@click="closeTourPreview()"
                        class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-slate-200 text-slate-500 transition hover:bg-slate-100 hover:text-slate-900"
                        aria-label="Close preview">
                    <span class="material-symbols-outlined text-[20px]">close</span>
                </button>
            </header>

            <div class="min-h-0 flex-1 overflow-y-auto">
                <div class="grid items-start lg:grid-cols-[320px_minmax(0,1fr)]">
                    <aside class="border-b border-slate-100 bg-slate-50/70 lg:sticky lg:top-0 lg:border-b-0 lg:border-r">
                        <div class="relative h-52 bg-gradient-to-br from-orange-100 to-slate-200 lg:h-60">
                            <div x-show="!previewTour?.imageUrl || failedImages[previewTour?.id]"
                                 class="absolute inset-0 flex items-center justify-center text-orange-300">
                                <span class="material-symbols-outlined text-6xl">landscape</span>
                            </div>
                            <img x-show="previewTour?.imageUrl && !failedImages[previewTour?.id]"
                                 :src="previewTour?.imageUrl" :alt="previewTour?.name || 'Tour cover'" class="h-full w-full object-cover">
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/65 via-transparent to-transparent"></div>
                            <div class="absolute bottom-4 left-4 right-4 text-white">
                                <p class="text-[10px] font-bold uppercase tracking-wider" x-text="previewTour?.city || 'Destination'"></p>
                                <p class="mt-1 line-clamp-2 text-lg font-black" x-text="previewTour?.name || 'Untitled draft'"></p>
                            </div>
                        </div>

                        <div class="space-y-4 p-4 sm:p-5">
                            <div class="grid grid-cols-2 gap-2 text-xs font-bold text-slate-700 lg:grid-cols-1">
                                <span class="inline-flex min-w-0 items-center gap-2 rounded-xl bg-white px-3 py-2.5 shadow-sm">
                                    <span class="material-symbols-outlined text-[17px] text-primary">date_range</span>
                                    <span class="truncate" x-text="durationLabel(previewTour)"></span>
                                </span>
                                <span class="inline-flex min-w-0 items-center gap-2 rounded-xl bg-white px-3 py-2.5 shadow-sm">
                                    <span class="material-symbols-outlined text-[17px] text-primary">schedule</span>
                                    <span class="truncate" x-text="timeRangeLabel(previewTour)"></span>
                                </span>
                                <span class="inline-flex min-w-0 items-center gap-2 rounded-xl bg-white px-3 py-2.5 shadow-sm">
                                    <span class="material-symbols-outlined text-[17px] text-primary">group</span>
                                    <span x-text="`Up to ${previewTour?.maxGuests} guests`"></span>
                                </span>
                                <span class="inline-flex min-w-0 items-center gap-2 rounded-xl bg-white px-3 py-2.5 shadow-sm">
                                    <span class="material-symbols-outlined text-[17px] text-primary">location_on</span>
                                    <span class="truncate" x-text="previewTour?.meetingPoint || 'Meeting point not added'"></span>
                                </span>
                            </div>

                            <div x-show="!previewTour?.schedule?.isConfigured"
                                 class="flex items-start gap-2 rounded-xl border border-amber-200 bg-amber-50 px-3 py-2.5 text-xs font-semibold text-amber-800">
                                <span class="material-symbols-outlined text-[18px]">warning</span>
                                <span>Add default start and end times before relying on this schedule.</span>
                            </div>

                            <div>
                                <p class="text-[10px] font-black uppercase tracking-wider text-slate-400">Schedule</p>
                                <p class="mt-1 text-sm font-bold text-slate-900" x-text="scheduleTypeLabel(previewTour)"></p>
                                <p class="mt-0.5 text-xs text-slate-500"
                                   x-text="`${previewTour?.schedule?.timeZone || 'Asia/Ho_Chi_Minh'} time`"></p>
                            </div>
                        </div>
                    </aside>

                    <main class="space-y-6 p-4 sm:p-6 lg:p-7">
                        <section>
                            <p class="text-[10px] font-black uppercase tracking-wider text-slate-400">Overview</p>
                            <p class="mt-2 whitespace-pre-line text-sm leading-7 text-slate-600"
                               :class="previewDescriptionExpanded ? '' : 'line-clamp-4'"
                               x-text="previewTour?.description || 'Add a description to help travelers understand this experience.'"></p>
                            <button x-show="(previewTour?.description || '').length > 320" type="button"
                                    @@click="previewDescriptionExpanded = !previewDescriptionExpanded"
                                    class="mt-2 text-xs font-bold text-primary hover:text-primary-dark"
                                    x-text="previewDescriptionExpanded ? 'Show less' : 'Show more'"></button>
                        </section>

                        <section>
                            <div class="flex items-end justify-between gap-3">
                                <div>
                                    <p class="text-[10px] font-black uppercase tracking-wider text-primary">Itinerary</p>
                                    <h3 class="mt-0.5 text-lg font-black text-slate-950">What travelers will do</h3>
                                </div>
                                <p class="shrink-0 text-xs font-semibold text-slate-400"
                                   x-text="`${previewTour?.schedule?.activityCount || 0} activities`"></p>
                            </div>

                            <div x-show="previewTour?.itineraryDays?.length" class="mt-4">
                                <div class="flex gap-2 overflow-x-auto pb-2" role="tablist" aria-label="Preview itinerary days">
                                    <template x-for="day in previewTour?.itineraryDays || []" :key="day.dayNumber">
                                        <button type="button" role="tab" @@click="previewActiveDay = day.dayNumber"
                                                :aria-selected="previewActiveDay === day.dayNumber"
                                                class="inline-flex shrink-0 items-center gap-2 rounded-xl border px-3 py-2 text-xs font-bold transition"
                                                :class="previewActiveDay === day.dayNumber ? 'border-primary bg-primary text-white shadow-sm' : 'border-slate-200 bg-white text-slate-600 hover:border-orange-200 hover:bg-orange-50'">
                                            <span x-text="`Day ${day.dayNumber}`"></span>
                                            <span class="rounded-full px-1.5 py-0.5 text-[9px]"
                                                  :class="previewActiveDay === day.dayNumber ? 'bg-white/20' : 'bg-slate-100 text-slate-500'"
                                                  x-text="day.items?.length || 0"></span>
                                        </button>
                                    </template>
                                </div>

                                <template x-if="activePreviewDay">
                                    <article class="mt-2 rounded-2xl border border-slate-200 bg-white p-4 sm:p-5">
                                        <div class="flex items-center gap-2 border-b border-slate-100 pb-3">
                                            <span class="rounded-lg bg-orange-50 px-2 py-1 text-[10px] font-black uppercase text-primary"
                                                  x-text="`Day ${activePreviewDay.dayNumber}`"></span>
                                            <h4 class="min-w-0 truncate text-sm font-black text-slate-900"
                                                x-text="activePreviewDay.title || `Day ${activePreviewDay.dayNumber} itinerary`"></h4>
                                        </div>
                                        <ol class="relative mt-4 space-y-1 before:absolute before:bottom-3 before:left-[5px] before:top-3 before:w-px before:bg-orange-100">
                                            <template x-for="(item, index) in activePreviewDay.items || []"
                                                      :key="`${activePreviewDay.dayNumber}-${index}`">
                                                <li class="relative grid grid-cols-1 gap-1 py-2.5 pl-5 text-xs sm:grid-cols-[112px_minmax(0,1fr)] sm:gap-3">
                                                    <span class="absolute left-0 top-[15px] h-[11px] w-[11px] rounded-full border-[3px] border-orange-100 bg-primary"></span>
                                                    <span class="whitespace-nowrap font-black tabular-nums text-primary" x-text="itineraryTime(item)"></span>
                                                    <div class="min-w-0">
                                                        <p class="break-words text-sm font-semibold leading-5 text-slate-700"
                                                           x-text="item.activity || 'Activity details not added'"></p>
                                                        <p x-show="item.location" class="mt-1 flex items-center gap-1 break-words text-xs text-slate-400">
                                                            <span class="material-symbols-outlined text-[14px]">location_on</span>
                                                            <span x-text="item.location"></span>
                                                        </p>
                                                    </div>
                                                </li>
                                            </template>
                                        </ol>
                                    </article>
                                </template>
                            </div>
                            <p x-show="!previewTour?.itineraryDays?.length"
                               class="mt-3 rounded-xl bg-slate-50 px-4 py-6 text-center text-sm text-slate-400">
                                No itinerary has been added yet.
                            </p>
                        </section>

                        <p class="text-center text-[11px] text-slate-400">This preview approximates what travelers will see.</p>
                    </main>
                </div>
            </div>

            <footer class="flex shrink-0 flex-col gap-3 border-t border-slate-100 bg-white px-4 py-3.5 sm:flex-row sm:items-center sm:justify-between sm:px-6">
                <div>
                    <p class="text-[10px] font-black uppercase tracking-wider text-orange-500">Tour price</p>
                    <div class="flex flex-wrap items-baseline gap-x-2">
                        <p class="text-xl font-black text-primary" x-text="formatCurrency(previewTour?.price)"></p>
                        <p class="text-xs text-orange-700" x-text="priceCaption(previewTour)"></p>
                    </div>
                </div>
                <a :href="`/Guide/CreateTour?id=${previewTour?.id}`" data-turbo="false"
                   class="inline-flex items-center justify-center gap-2 rounded-xl bg-slate-950 px-5 py-2.5 text-sm font-bold text-white transition hover:bg-primary">
                    <span class="material-symbols-outlined text-[17px]">edit</span> Edit tour
                </a>
            </footer>
        </article>
    </div>

    <div x-show="actionDialogOpen" class="fixed inset-0 z-[100] flex items-center justify-center p-4"
         style="display:none" role="dialog" aria-modal="true" aria-labelledby="tour-action-title">
        <div class="absolute inset-0 bg-slate-950/55"
             @@click="!isProcessingAction && (actionDialogOpen = false)"></div>
        <div class="relative w-full max-w-md rounded-2xl bg-white p-6 shadow-2xl">
            <h2 id="tour-action-title" class="text-lg font-black text-slate-950" x-text="pendingAction?.title"></h2>
            <p class="mt-2 text-sm leading-6 text-slate-500" x-text="pendingAction?.description"></p>
            <p class="mt-3 truncate rounded-xl bg-slate-50 px-3 py-2 text-xs font-bold text-slate-600"
               x-text="pendingAction?.tour?.name"></p>
            <div class="mt-6 flex justify-end gap-2">
                <button type="button" @@click="actionDialogOpen = false" :disabled="isProcessingAction"
                        class="rounded-xl px-4 py-2.5 text-sm font-bold text-slate-600">
                    Cancel
                </button>
                <button type="button" @@click="confirmAction" :disabled="isProcessingAction"
                        :class="pendingAction?.type === 'delete' ? 'bg-red-600' : 'bg-primary'"
                        class="inline-flex min-w-28 items-center justify-center rounded-xl px-4 py-2.5 text-sm font-bold text-white disabled:opacity-60">
                    <span x-text="isProcessingAction ? 'Working…' : pendingAction?.confirmLabel"></span>
                </button>
            </div>
        </div>
    </div>
</div>
