@model TripMate_WebAPI.DTOs.GuideEarningsReportViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Báo Cáo Thu Nhập";
    ViewData["ActivePage"] = "Earnings";
    ViewData["TurboCacheControl"] = "no-cache";
    Layout = "_GuideLayout";

    var transactionsJson = JsonSerializer.Serialize(Model.Transactions);
    var chartLabelsJson = JsonSerializer.Serialize(Model.ChartLabels);
    var chartDataJson = JsonSerializer.Serialize(Model.ChartData);
}

<script>
    window.guideEarningsReport = {
        transactions: @Html.Raw(transactionsJson),
        chartLabels: @Html.Raw(chartLabelsJson),
        chartData: @Html.Raw(chartDataJson),
        averageRating: @Model.AverageRating.ToString(System.Globalization.CultureInfo.InvariantCulture),
        reviewsCount: @Model.ReviewsCount
    };
</script>

<div x-data="earningsApp()">
    <div class="mb-8 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div>
            <h2 class="mb-1 text-3xl font-bold text-gray-900">Báo Cáo Thu Nhập</h2>
            <p class="text-sm text-gray-500">Theo dõi tiền đã nhận, khoản chờ giải ngân và lịch sử thu nhập thực tế.</p>
        </div>
        <div class="flex flex-col items-start gap-2 sm:items-end">
            <div class="flex items-center rounded-xl border border-gray-200 bg-white p-1 shadow-sm" role="group" aria-label="Khoảng thời gian báo cáo">
                <button type="button" @@click="period = 'week'" :aria-pressed="period === 'week'" :class="period === 'week' ? 'bg-gray-100 font-bold text-gray-900' : 'text-gray-500 hover:text-gray-700'" class="rounded-lg px-4 py-2 text-sm transition-colors">Tuần này</button>
                <button type="button" @@click="period = 'month'" :aria-pressed="period === 'month'" :class="period === 'month' ? 'bg-gray-100 font-bold text-gray-900' : 'text-gray-500 hover:text-gray-700'" class="rounded-lg px-4 py-2 text-sm transition-colors">Tháng này</button>
                <button type="button" @@click="period = 'year'" :aria-pressed="period === 'year'" :class="period === 'year' ? 'bg-gray-100 font-bold text-gray-900' : 'text-gray-500 hover:text-gray-700'" class="rounded-lg px-4 py-2 text-sm transition-colors">Năm này</button>
            </div>
            <p class="text-xs text-gray-400">Cập nhật @Model.GeneratedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="mb-6 flex items-start gap-3 rounded-2xl border border-red-200 bg-red-50 p-4 text-red-800" role="alert">
            <span class="material-symbols-outlined mt-0.5 text-[20px]" aria-hidden="true">error</span>
            <div>
                <p class="font-bold">Không thể tải đầy đủ báo cáo</p>
                <p class="mt-1 text-sm">@Model.ErrorMessage</p>
            </div>
        </div>
    }

    <div class="mb-8 grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-4">
        <div class="group relative overflow-hidden rounded-2xl border border-gray-100 bg-white p-6 shadow-sm">
            <div class="absolute -right-4 -top-4 flex h-24 w-24 items-center justify-center rounded-full bg-green-50 transition-transform group-hover:scale-110">
                <span class="material-symbols-outlined text-[40px] text-green-500 opacity-20" aria-hidden="true">account_balance_wallet</span>
            </div>
            <p class="mb-2 text-sm font-bold uppercase tracking-wider text-gray-500">Đã Nhận</p>
            <h3 class="mb-1 text-3xl font-bold text-gray-900" x-text="formatCurrency(received)">@string.Format("{0:N0} ₫", Model.Received)</h3>
            <p class="text-sm text-green-700"><span class="font-semibold">Đã giải ngân</span> trong <span x-text="periodLabel.toLowerCase()">tháng này</span></p>
        </div>

        <div class="group relative overflow-hidden rounded-2xl border border-gray-100 bg-white p-6 shadow-sm">
            <div class="absolute -right-4 -top-4 flex h-24 w-24 items-center justify-center rounded-full bg-amber-50 transition-transform group-hover:scale-110">
                <span class="material-symbols-outlined text-[40px] text-amber-500 opacity-20" aria-hidden="true">hourglass_empty</span>
            </div>
            <div class="mb-2 flex items-center gap-1">
                <p class="text-sm font-bold uppercase tracking-wider text-gray-500">Chưa Nhận</p>
                <span class="material-symbols-outlined cursor-help text-[16px] text-gray-400" title="Gồm tiền đang tạm giữ và tour đã hoàn thành nhưng chưa giải ngân" aria-hidden="true">info</span>
            </div>
            <h3 class="mb-1 text-3xl font-bold text-gray-900" x-text="formatCurrency(pending)">@string.Format("{0:N0} ₫", Model.Pending)</h3>
            <p class="text-sm text-gray-400">Tạm giữ hoặc đang chờ giải ngân</p>
        </div>

        <div class="group relative overflow-hidden rounded-2xl border border-gray-100 bg-white p-6 shadow-sm">
            <div class="absolute -right-4 -top-4 flex h-24 w-24 items-center justify-center rounded-full bg-blue-50 transition-transform group-hover:scale-110">
                <span class="material-symbols-outlined text-[40px] text-blue-500 opacity-20" aria-hidden="true">tour</span>
            </div>
            <p class="mb-2 text-sm font-bold uppercase tracking-wider text-gray-500">Tour Hoàn Thành</p>
            <h3 class="mb-1 text-3xl font-bold text-gray-900" x-text="completedTours">@Model.CompletedTours</h3>
            <p class="text-sm text-gray-400">Hoàn thành trong <span x-text="periodLabel.toLowerCase()">tháng này</span></p>
        </div>

        <div class="group relative overflow-hidden rounded-2xl border border-gray-100 bg-white p-6 shadow-sm">
            <div class="absolute -right-4 -top-4 flex h-24 w-24 items-center justify-center rounded-full bg-orange-50 transition-transform group-hover:scale-110">
                <span class="material-symbols-outlined text-[40px] text-amber-500 opacity-20" style="font-variation-settings: 'FILL' 1;" aria-hidden="true">star</span>
            </div>
            <p class="mb-2 text-sm font-bold uppercase tracking-wider text-gray-500">Đánh Giá Trung Bình</p>
            <div class="flex items-baseline gap-2">
                <h3 class="mb-1 text-3xl font-bold text-gray-900" x-text="ratingLabel">@(Model.ReviewsCount > 0 ? Model.AverageRating.ToString("0.0") : "—")</h3>
                <span class="material-symbols-outlined text-[24px] text-amber-400" style="font-variation-settings: 'FILL' 1;" aria-hidden="true">star</span>
            </div>
            <p class="text-sm text-gray-400" x-text="reviewsLabel">@(Model.ReviewsCount > 0 ? $"Dựa trên {Model.ReviewsCount:N0} phản hồi" : "Chưa có phản hồi")</p>
        </div>
    </div>

    <section class="mb-8 rounded-2xl border border-gray-100 bg-white p-6 shadow-sm" aria-labelledby="earnings-chart-title">
        <div class="mb-6 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <h3 id="earnings-chart-title" class="text-lg font-bold text-gray-900">Thu Nhập Đã Nhận Trong 12 Tháng</h3>
                <p class="mt-1 text-xs text-gray-500">Tính theo ngày ghi nhận giao dịch giải ngân thực tế.</p>
            </div>
            <p class="text-sm font-bold text-gray-700" x-text="formatCurrency(yearlyReceived)"></p>
        </div>
        <div class="relative h-80 w-full">
            <canvas x-ref="earningsChart" role="img" aria-label="Biểu đồ thu nhập đã nhận trong 12 tháng gần nhất"></canvas>
            <div x-show="!hasChartData" x-cloak class="pointer-events-none absolute inset-0 flex items-center justify-center">
                <div class="rounded-xl bg-white/90 px-4 py-3 text-center shadow-sm">
                    <p class="font-semibold text-gray-700">Chưa có khoản giải ngân trong 12 tháng gần nhất</p>
                    <p class="mt-1 text-xs text-gray-500">Dữ liệu sẽ xuất hiện khi một khoản thu nhập được giải ngân.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-sm" aria-labelledby="transaction-history-title">
        <div class="flex flex-col items-start justify-between gap-4 border-b border-gray-100 p-6 lg:flex-row lg:items-center">
            <div>
                <h3 id="transaction-history-title" class="text-lg font-bold text-gray-900">Lịch Sử Thu Nhập</h3>
                <p class="mt-1 text-xs text-gray-500">Hiển thị giao dịch trong <span x-text="periodLabel.toLowerCase()">tháng này</span>.</p>
            </div>
            <div class="flex w-full flex-col gap-3 sm:flex-row lg:w-auto">
                <label class="relative flex-grow lg:flex-grow-0">
                    <span class="sr-only">Tìm giao dịch</span>
                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-[18px] text-gray-400" aria-hidden="true">search</span>
                    <input type="search" x-model.debounce.200ms="searchQuery" placeholder="Tìm theo mã, tour, khách..." class="w-full rounded-xl border border-gray-200 bg-gray-50 py-2 pl-9 pr-4 text-sm text-gray-900 outline-none focus:ring-2 focus:ring-primary/50 lg:w-72">
                </label>
                <button type="button" @@click="downloadCsv()" :disabled="filteredTransactions.length === 0" class="flex flex-shrink-0 items-center justify-center gap-2 rounded-xl border border-gray-200 bg-white px-4 py-2 text-sm font-bold text-gray-700 shadow-sm transition-colors hover:bg-gray-50 disabled:cursor-not-allowed disabled:opacity-50">
                    <span class="material-symbols-outlined text-[18px]" aria-hidden="true">download</span>
                    Xuất CSV
                </button>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full min-w-[980px] text-left text-sm text-gray-600">
                <thead class="border-b border-gray-100 bg-gray-50/50 font-medium text-gray-500">
                    <tr>
                        <th class="px-6 py-4">Ngày tour</th>
                        <th class="px-6 py-4">Gói Tour & Khách</th>
                        <th class="px-6 py-4 text-right">Tổng Tour</th>
                        <th class="px-6 py-4 text-right">Phí nền tảng</th>
                        <th class="px-6 py-4 text-right">Thực nhận</th>
                        <th class="px-6 py-4">Trạng thái</th>
                        <th class="px-6 py-4"><span class="sr-only">Chi tiết</span></th>
                    </tr>
                </thead>

                <template x-for="transaction in paginatedTransactions" :key="transaction.Id">
                    <tbody class="divide-y divide-gray-100 border-b border-gray-100 last:border-b-0">
                        <tr class="transition-colors hover:bg-gray-50">
                            <td class="px-6 py-4">
                                <div class="font-medium text-gray-900" x-text="formatDate(transaction.BookingDate)"></div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="font-medium text-gray-900" x-text="transaction.TourName"></div>
                                <div class="mt-0.5 flex items-center gap-1 text-xs text-gray-500">
                                    <span class="material-symbols-outlined text-[14px]" aria-hidden="true">person</span>
                                    <span x-text="transaction.TravelerName"></span>
                                </div>
                            </td>
                            <td class="px-6 py-4 text-right text-gray-500" x-text="formatCurrency(transaction.TotalAmount)"></td>
                            <td class="px-6 py-4 text-right text-red-500" x-text="'-' + formatCurrency(transaction.PlatformFee)"></td>
                            <td class="px-6 py-4 text-right font-bold text-green-600" x-text="formatCurrency(transaction.NetEarnings)"></td>
                            <td class="px-6 py-4">
                                <span class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs font-bold" :class="statusClasses(transaction.Status)">
                                    <span class="material-symbols-outlined text-[14px]" aria-hidden="true" x-text="statusIcon(transaction.Status)"></span>
                                    <span x-text="statusText(transaction.Status)"></span>
                                </span>
                            </td>
                            <td class="px-6 py-4 text-right">
                                <button type="button" @@click="toggleExpanded(transaction)" :aria-expanded="transaction.expanded" :aria-label="`Xem chi tiết booking ${transaction.Id}`" class="text-gray-400 transition-colors hover:text-primary">
                                    <span class="material-symbols-outlined text-[20px] transition-transform duration-200" :class="transaction.expanded ? 'rotate-180' : ''" aria-hidden="true">expand_more</span>
                                </button>
                            </td>
                        </tr>
                        <tr x-show="transaction.expanded" x-transition.opacity style="display: none;" class="bg-gray-50/70">
                            <td colspan="7" class="px-6 py-4">
                                <div class="grid gap-5 border-l-2 border-primary pl-4 md:grid-cols-2 xl:grid-cols-4">
                                    <div>
                                        <p class="mb-1 text-xs uppercase tracking-wider text-gray-500">Mã thanh toán</p>
                                        <p class="break-all font-mono text-sm font-bold text-gray-900" x-text="transaction.PaymentReference || 'Chưa có'"></p>
                                    </div>
                                    <div>
                                        <p class="mb-1 text-xs uppercase tracking-wider text-gray-500">Mã sổ cái</p>
                                        <p class="break-all font-mono text-sm font-bold text-gray-900" x-text="transaction.LedgerReference || 'Chưa ghi nhận'"></p>
                                    </div>
                                    <div>
                                        <p class="mb-1 text-xs uppercase tracking-wider text-gray-500">Giải ngân</p>
                                        <p class="text-sm font-bold text-gray-900" x-text="releaseText(transaction)"></p>
                                    </div>
                                    <div class="flex items-end xl:justify-end">
                                        <a :href="`/Guide/Bookings?bookingId=${encodeURIComponent(transaction.Id)}`" class="inline-flex items-center gap-1 text-sm font-bold text-primary hover:underline">
                                            Xem chi tiết Booking <span class="material-symbols-outlined text-[16px]" aria-hidden="true">arrow_forward</span>
                                        </a>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </template>

                <tbody x-show="filteredTransactions.length === 0" x-cloak>
                    <tr>
                        <td colspan="7" class="px-6 py-14 text-center">
                            <span class="material-symbols-outlined text-[38px] text-gray-300" aria-hidden="true">receipt_long</span>
                            <p class="mt-2 font-bold text-gray-700">Không có giao dịch phù hợp</p>
                            <p class="mt-1 text-sm text-gray-500" x-text="searchQuery ? 'Thử một từ khóa khác hoặc xóa bộ lọc tìm kiếm.' : `Chưa có thu nhập trong ${periodLabel.toLowerCase()}.`"></p>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="flex flex-col gap-3 border-t border-gray-100 p-4 sm:flex-row sm:items-center sm:justify-between">
            <span class="text-sm text-gray-500">
                Hiển thị <span class="font-semibold" x-text="pageStart"></span>–<span class="font-semibold" x-text="pageEnd"></span> trong <span class="font-semibold" x-text="filteredTransactions.length"></span> giao dịch
            </span>
            <div class="flex items-center gap-2">
                <button type="button" @@click="previousPage()" :disabled="currentPage === 1" aria-label="Trang trước" class="flex h-9 w-9 items-center justify-center rounded-lg border border-gray-200 text-gray-500 hover:bg-gray-50 disabled:cursor-not-allowed disabled:opacity-40">
                    <span class="material-symbols-outlined text-[18px]" aria-hidden="true">chevron_left</span>
                </button>
                <span class="min-w-24 text-center text-sm font-semibold text-gray-700">Trang <span x-text="currentPage"></span> / <span x-text="totalPages"></span></span>
                <button type="button" @@click="nextPage()" :disabled="currentPage === totalPages" aria-label="Trang sau" class="flex h-9 w-9 items-center justify-center rounded-lg border border-gray-200 text-gray-500 hover:bg-gray-50 disabled:cursor-not-allowed disabled:opacity-40">
                    <span class="material-symbols-outlined text-[18px]" aria-hidden="true">chevron_right</span>
                </button>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script>
        function earningsApp() {
            const source = window.guideEarningsReport || {};

            return {
                period: 'month',
                searchQuery: '',
                currentPage: 1,
                pageSize: 8,
                transactions: (source.transactions || []).map(transaction => ({ ...transaction, expanded: false })),
                chartLabels: source.chartLabels || [],
                chartData: source.chartData || [],
                averageRating: Number(source.averageRating || 0),
                reviewsCount: Number(source.reviewsCount || 0),

                init() {
                    this.$watch('period', () => { this.currentPage = 1; });
                    this.$watch('searchQuery', () => { this.currentPage = 1; });
                    this.initChart();
                },

                get periodLabel() {
                    return this.period === 'week' ? 'Tuần này' : this.period === 'year' ? 'Năm này' : 'Tháng này';
                },

                get received() {
                    return this.transactions
                        .filter(transaction => transaction.Status === 'Received' && this.isInPeriod(transaction.ReleaseDate))
                        .reduce((sum, transaction) => sum + Number(transaction.NetEarnings || 0), 0);
                },

                get pending() {
                    return this.transactions
                        .filter(transaction => transaction.Status !== 'Received' && this.isInPeriod(transaction.EventDate))
                        .reduce((sum, transaction) => sum + Number(transaction.NetEarnings || 0), 0);
                },

                get completedTours() {
                    return this.transactions.filter(transaction =>
                        Number(transaction.BookingStatus) === 2 &&
                        this.isInPeriod(transaction.BookingDate)).length;
                },

                get ratingLabel() {
                    return this.reviewsCount > 0 ? this.averageRating.toFixed(1) : '—';
                },

                get reviewsLabel() {
                    return this.reviewsCount > 0
                        ? `Dựa trên ${new Intl.NumberFormat('vi-VN').format(this.reviewsCount)} phản hồi`
                        : 'Chưa có phản hồi';
                },

                get yearlyReceived() {
                    return this.chartData.reduce((sum, value) => sum + Number(value || 0), 0);
                },

                get hasChartData() {
                    return this.chartData.some(value => Number(value) > 0);
                },

                get filteredTransactions() {
                    const query = this.searchQuery.trim().toLocaleLowerCase('vi-VN');
                    return this.transactions.filter(transaction => {
                        if (!this.isInPeriod(transaction.EventDate)) return false;
                        if (!query) return true;

                        return [
                            transaction.Id,
                            transaction.TravelerName,
                            transaction.TourName,
                            transaction.PaymentReference,
                            transaction.LedgerReference
                        ].some(value => String(value || '').toLocaleLowerCase('vi-VN').includes(query));
                    });
                },

                get totalPages() {
                    return Math.max(1, Math.ceil(this.filteredTransactions.length / this.pageSize));
                },

                get paginatedTransactions() {
                    const start = (this.currentPage - 1) * this.pageSize;
                    return this.filteredTransactions.slice(start, start + this.pageSize);
                },

                get pageStart() {
                    return this.filteredTransactions.length === 0 ? 0 : ((this.currentPage - 1) * this.pageSize) + 1;
                },

                get pageEnd() {
                    return Math.min(this.currentPage * this.pageSize, this.filteredTransactions.length);
                },

                periodBounds() {
                    const now = new Date();
                    const start = new Date(now.getFullYear(), now.getMonth(), now.getDate());
                    let end;

                    if (this.period === 'week') {
                        const daysFromMonday = (start.getDay() + 6) % 7;
                        start.setDate(start.getDate() - daysFromMonday);
                        end = new Date(start);
                        end.setDate(end.getDate() + 7);
                    } else if (this.period === 'year') {
                        start.setMonth(0, 1);
                        end = new Date(start.getFullYear() + 1, 0, 1);
                    } else {
                        start.setDate(1);
                        end = new Date(start.getFullYear(), start.getMonth() + 1, 1);
                    }

                    return { start, end };
                },

                isInPeriod(value) {
                    if (!value) return false;
                    const date = new Date(value);
                    if (Number.isNaN(date.getTime())) return false;
                    const { start, end } = this.periodBounds();
                    return date >= start && date < end;
                },

                formatCurrency(value) {
                    return new Intl.NumberFormat('vi-VN', {
                        style: 'currency',
                        currency: 'VND',
                        maximumFractionDigits: 0
                    }).format(Number(value || 0));
                },

                formatDate(value) {
                    if (!value) return '—';
                    const date = new Date(value);
                    return Number.isNaN(date.getTime())
                        ? '—'
                        : new Intl.DateTimeFormat('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' }).format(date);
                },

                statusText(status) {
                    if (status === 'Received') return 'Đã nhận';
                    if (status === 'AwaitingPayout') return 'Chờ giải ngân';
                    return 'Đang tạm giữ';
                },

                statusIcon(status) {
                    if (status === 'Received') return 'check_circle';
                    if (status === 'AwaitingPayout') return 'pending_actions';
                    return 'lock_clock';
                },

                statusClasses(status) {
                    if (status === 'Received') return 'border-green-100 bg-green-50 text-green-700';
                    if (status === 'AwaitingPayout') return 'border-blue-100 bg-blue-50 text-blue-700';
                    return 'border-amber-100 bg-amber-50 text-amber-700';
                },

                releaseText(transaction) {
                    if (transaction.Status === 'Received') return this.formatDate(transaction.ReleaseDate);
                    if (transaction.Status === 'AwaitingPayout') return 'Tour đã hoàn thành, đang chờ giải ngân';
                    return 'Sau khi tour hoàn thành';
                },

                toggleExpanded(transaction) {
                    transaction.expanded = !transaction.expanded;
                },

                previousPage() {
                    if (this.currentPage > 1) this.currentPage--;
                },

                nextPage() {
                    if (this.currentPage < this.totalPages) this.currentPage++;
                },

                downloadCsv() {
                    if (this.filteredTransactions.length === 0) return;

                    const escapeCsv = value => `"${String(value ?? '').replaceAll('"', '""')}"`;
                    const rows = [
                        ['Mã booking', 'Ngày tour', 'Tour', 'Khách', 'Tổng tour', 'Phí nền tảng', 'Thực nhận', 'Trạng thái', 'Ngày giải ngân', 'Mã thanh toán', 'Mã sổ cái'],
                        ...this.filteredTransactions.map(transaction => [
                            transaction.Id,
                            this.formatDate(transaction.BookingDate),
                            transaction.TourName,
                            transaction.TravelerName,
                            transaction.TotalAmount,
                            transaction.PlatformFee,
                            transaction.NetEarnings,
                            this.statusText(transaction.Status),
                            transaction.ReleaseDate ? this.formatDate(transaction.ReleaseDate) : '',
                            transaction.PaymentReference || '',
                            transaction.LedgerReference || ''
                        ])
                    ];
                    const csv = '\uFEFF' + rows.map(row => row.map(escapeCsv).join(',')).join('\r\n');
                    const blobUrl = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8' }));
                    const link = document.createElement('a');
                    link.href = blobUrl;
                    link.download = `tripmate-thu-nhap-${this.period}-${new Date().toISOString().slice(0, 10)}.csv`;
                    document.body.appendChild(link);
                    link.click();
                    link.remove();
                    URL.revokeObjectURL(blobUrl);
                },

                initChart() {
                    const canvas = this.$refs.earningsChart;
                    if (!canvas || typeof Chart === 'undefined') return;

                    if (window.guideEarningsReportChart) window.guideEarningsReportChart.destroy();
                    const context = canvas.getContext('2d');
                    const gradient = context.createLinearGradient(0, 0, 0, 360);
                    gradient.addColorStop(0, 'rgba(234, 88, 12, 0.82)');
                    gradient.addColorStop(1, 'rgba(234, 88, 12, 0.18)');

                    window.guideEarningsReportChart = new Chart(context, {
                        type: 'bar',
                        data: {
                            labels: this.chartLabels,
                            datasets: [{
                                label: 'Thu nhập đã nhận',
                                data: this.chartData,
                                backgroundColor: gradient,
                                borderRadius: 6,
                                borderSkipped: false,
                                hoverBackgroundColor: 'rgba(234, 88, 12, 1)',
                                barPercentage: 0.62
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    backgroundColor: 'rgba(17, 24, 39, 0.94)',
                                    padding: 12,
                                    callbacks: { label: context => this.formatCurrency(context.parsed.y) }
                                }
                            },
                            scales: {
                                y: {
                                    beginAtZero: true,
                                    grid: { color: 'rgba(243, 244, 246, 1)' },
                                    ticks: {
                                        color: '#6B7280',
                                        callback: value => value >= 1000000 ? `${value / 1000000}Tr` : value >= 1000 ? `${value / 1000}K` : value
                                    }
                                },
                                x: { grid: { display: false }, ticks: { color: '#6B7280' } }
                            }
                        }
                    });
                }
            };
        }

        document.addEventListener('turbo:before-cache', () => {
            if (window.guideEarningsReportChart) {
                window.guideEarningsReportChart.destroy();
                window.guideEarningsReportChart = null;
            }
        });
    </script>
}
