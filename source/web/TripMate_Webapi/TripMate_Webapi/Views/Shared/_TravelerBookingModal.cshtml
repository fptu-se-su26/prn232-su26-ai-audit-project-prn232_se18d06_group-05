<!-- Booking details must be confirmed before a PayOS payment attempt is created. -->
<div x-show="showBooking" style="display:none;"
     class="fixed inset-0 z-[200] flex items-center justify-center p-4"
     role="dialog" aria-modal="true" aria-labelledby="home-booking-title">
    <div class="fixed inset-0 bg-black/70 backdrop-blur-sm" @@click="closeBooking()"></div>

    <div x-show="showBooking"
         x-transition:enter="ease-out duration-200"
         x-transition:enter-start="opacity-0 scale-95"
         x-transition:enter-end="opacity-100 scale-100"
         class="relative z-10 w-full max-w-lg overflow-hidden rounded-3xl bg-white shadow-2xl">
        <div class="flex items-start justify-between border-b border-outline-variant/30 px-6 py-5">
            <div>
                <p class="text-xs font-bold uppercase tracking-[0.16em] text-primary">Complete your booking</p>
                <h2 id="home-booking-title" class="mt-1 text-xl font-extrabold text-on-surface" x-text="modal.title"></h2>
                <p class="mt-1 text-sm text-on-surface-variant">Choose your trip details before continuing to payment.</p>
            </div>
            <button type="button" @@click="closeBooking()"
                    class="rounded-full border border-outline-variant/40 p-2 text-on-surface-variant hover:text-primary"
                    aria-label="Close booking form">
                <span class="material-symbols-outlined block">close</span>
            </button>
        </div>

        <div class="max-h-[70vh] space-y-5 overflow-y-auto px-6 py-5">
            <div>
                <label for="home-booking-date" class="mb-2 block text-sm font-bold text-on-surface">Trip date</label>
                <input id="home-booking-date" type="text" x-ref="datePicker" x-model="bookingDate"
                       class="w-full rounded-xl border border-outline-variant/50 bg-surface px-4 py-3 focus:border-primary focus:outline-none" placeholder="Select date">
            </div>

            <div>
                <label class="mb-2 block text-sm font-bold text-on-surface">Guests</label>
                <div class="flex items-center overflow-hidden rounded-xl border border-outline-variant/50 bg-surface">
                    <button type="button" @@click="bookingGuests = Math.max(1, bookingGuests - 1)"
                            class="px-5 py-3 font-bold hover:bg-surface-variant">−</button>
                    <input type="number" x-model.number="bookingGuests" min="1" :max="modal.maxGroup"
                           class="w-full bg-transparent px-4 py-3 text-center text-lg font-bold focus:outline-none">
                    <button type="button" @@click="bookingGuests = Math.min(modal.maxGroup, bookingGuests + 1)"
                            class="px-5 py-3 font-bold hover:bg-surface-variant">+</button>
                </div>
                <p class="mt-2 text-xs text-on-surface-variant" x-text="'Maximum ' + modal.maxGroup + ' guests'"></p>
            </div>

            <div>
                <label for="home-booking-notes" class="mb-2 block text-sm font-bold text-on-surface">Notes for the guide <span class="font-normal text-on-surface-variant">(optional)</span></label>
                <textarea id="home-booking-notes" x-model.trim="bookingNotes" rows="3" maxlength="500"
                          placeholder="Dietary requirements, accessibility needs, or special requests"
                          class="w-full resize-none rounded-xl border border-outline-variant/50 bg-surface px-4 py-3 focus:border-primary focus:outline-none"></textarea>
            </div>

            <div class="rounded-2xl border border-primary/20 bg-primary/5 p-4">
                <div class="flex items-center justify-between">
                    <span class="text-sm text-on-surface-variant">Tour total</span>
                    <strong class="text-xl text-primary" x-text="formatCurrency(bookingTotal)"></strong>
                </div>
                <div class="mt-2 flex items-center justify-between border-t border-primary/10 pt-2 text-sm">
                    <span class="text-on-surface-variant">Due now · 30% deposit</span>
                    <strong class="text-on-surface" x-text="formatCurrency(bookingDeposit)"></strong>
                </div>
                <p class="mt-2 text-xs text-on-surface-variant"
                   x-text="modal.pricePerPerson > 0 ? 'Includes ' + modal.includedGuestCount + ' guest(s); extra guests are charged separately.' : 'Fixed price for the whole tour.'"></p>
            </div>

            <p x-show="bookingError" x-text="bookingError" class="rounded-xl bg-red-50 px-4 py-3 text-sm font-semibold text-red-700"></p>
        </div>

        <div class="flex gap-3 border-t border-outline-variant/30 bg-surface px-6 py-4">
            <button type="button" @@click="closeBooking()" :disabled="bookingInProgress"
                    class="flex-1 rounded-xl border border-outline-variant/50 px-4 py-3 font-bold text-on-surface">
                Cancel
            </button>
            <button type="button" @@click="submitTourBooking()" :disabled="bookingInProgress"
                    class="flex-[1.6] rounded-xl bg-primary px-4 py-3 font-bold text-white shadow-md disabled:cursor-not-allowed disabled:opacity-60">
                <span x-text="bookingInProgress ? 'Creating payment…' : 'Continue to payment'"></span>
            </button>
        </div>
    </div>
</div>
