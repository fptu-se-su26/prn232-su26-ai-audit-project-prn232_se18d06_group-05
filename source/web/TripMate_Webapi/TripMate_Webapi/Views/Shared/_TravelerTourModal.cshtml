<!-- ═══ Traveler Tour Detail Modal ═══ -->
<div x-show="showModal" class="fixed inset-0 z-[90] flex items-center justify-center p-4"
     style="display:none" role="dialog" aria-modal="true" aria-label="Tour Details">
    <!-- Backdrop -->
    <div class="absolute inset-0 bg-slate-950/60 backdrop-blur-sm transition-opacity" @@click="showModal = false"></div>
    
    <!-- Modal Content -->
    <article x-show="showModal" x-transition:enter="ease-out duration-300" x-transition:enter-start="opacity-0 scale-95" x-transition:enter-end="opacity-100 scale-100" x-transition:leave="ease-in duration-200" x-transition:leave-start="opacity-100 scale-100" x-transition:leave-end="opacity-0 scale-95"
        class="relative max-h-[90vh] w-full max-w-2xl overflow-y-auto rounded-3xl bg-white shadow-2xl flex flex-col z-10" @@click.stop>
        
        <!-- Header Image Area -->
        <div class="relative h-56 sm:h-72 bg-gradient-to-br from-orange-100 to-slate-200 shrink-0">
            <template x-if="!modal.coverImageUrl">
                <div class="absolute inset-0 flex items-center justify-center text-orange-300">
                    <span class="material-symbols-outlined text-6xl">landscape</span>
                </div>
            </template>
            <template x-if="modal.coverImageUrl">
                <img :src="modal.coverImageUrl" alt="" class="h-full w-full object-cover">
            </template>
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-950/20 to-transparent"></div>
            
            <button type="button" @@click="showModal = false"
                    class="absolute right-4 top-4 flex h-10 w-10 items-center justify-center rounded-full bg-white/90 text-slate-700 hover:bg-white transition-colors"
                    aria-label="Close modal">
                <span class="material-symbols-outlined">close</span>
            </button>
            
            <div class="absolute bottom-5 left-6 right-6 text-white drop-shadow-md">
                <p class="text-xs font-bold uppercase tracking-wider flex items-center gap-1">
                    <span class="material-symbols-outlined text-[14px]">location_on</span>
                    <span x-text="modal.cityArea || 'Vietnam'"></span>
                </p>
                <h2 class="mt-1 text-3xl font-black" x-text="modal.title || 'Untitled Tour'"></h2>
            </div>
        </div>

        <!-- Body Content -->
        <div class="space-y-6 p-6 sm:p-8 flex-1">
            
            <!-- Quick Info Tags -->
            <div class="flex flex-wrap gap-3 text-xs font-bold text-slate-700">
                <span class="inline-flex items-center gap-1.5 rounded-xl bg-primary/10 text-primary px-3 py-2">
                    <span class="material-symbols-outlined text-[16px]">schedule</span>
                    <span x-text="modal.duration + ' hours'"></span>
                </span>
                <span class="inline-flex items-center gap-1.5 rounded-xl bg-surface-variant px-3 py-2 text-on-surface-variant">
                    <span class="material-symbols-outlined text-[16px]">group</span>
                    <span x-text="'Max ' + modal.maxGroup + ' guests'"></span>
                </span>
            </div>

            <!-- Description -->
            <div>
                <h3 class="text-lg font-black text-slate-950 mb-3 flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary text-xl">route</span> About this tour
                </h3>
                <p class="whitespace-pre-line text-sm leading-relaxed text-slate-600"
                   x-text="modal.description || 'No description provided.'"></p>
            </div>

            <!-- Included Items -->
            <div x-show="modal.includedItems && modal.includedItems.length > 0">
                <h3 class="text-lg font-black text-slate-950 mb-3 flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary text-xl">check_circle</span> What's Included
                </h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <template x-for="item in modal.includedItems" :key="item">
                        <div class="flex items-start gap-2 bg-green-50/50 border border-green-100 px-3 py-2.5 rounded-xl">
                            <span class="material-symbols-outlined text-green-500 text-[18px]">check</span>
                            <span class="text-sm text-slate-700 font-medium" x-text="item"></span>
                        </div>
                    </template>
                </div>
            </div>

            <!-- Itinerary -->
            <div x-show="modal.timeline && modal.timeline.length > 0">
                <div class="flex items-end justify-between gap-3 mb-3">
                    <div>
                        <h3 class="text-lg font-black text-slate-950 flex items-center gap-2">
                            <span class="material-symbols-outlined text-primary text-xl">map</span> What you'll do
                        </h3>
                    </div>
                </div>
                
                <div class="space-y-3">
                    <template x-for="day in modal.timeline" :key="day.dayNumber">
                        <article class="rounded-2xl border border-slate-100 p-4 bg-slate-50/50">
                            <div class="flex items-baseline gap-2">
                                <span class="rounded-lg bg-orange-50 px-2 py-1 text-[10px] font-black uppercase text-primary"
                                      x-text="`Day ${day.dayNumber}`"></span>
                                <h4 class="text-sm font-black text-slate-900"
                                    x-text="day.title || `Day ${day.dayNumber} itinerary`"></h4>
                            </div>
                            <ol class="mt-3 space-y-2.5">
                                <template x-for="(item, index) in (day.items || [])"
                                          :key="`${day.dayNumber}-${index}`">
                                    <li class="grid grid-cols-[72px_1fr] gap-3 text-xs">
                                        <span class="font-bold text-primary" x-text="item.startTime ? (item.startTime + (item.endTime ? ' - ' + item.endTime : '')) : 'Time TBA'"></span>
                                        <div>
                                            <p class="font-semibold text-slate-700"
                                               x-text="item.activity || 'Activity details not added'"></p>
                                            <p x-show="item.location" class="mt-0.5 text-slate-400"
                                               x-text="item.location"></p>
                                        </div>
                                    </li>
                                </template>
                            </ol>
                        </article>
                    </template>
                </div>
            </div>

            <!-- Guide Info -->
            <a :href="'/Traveler/GuideProfile/' + modal.guideId" class="block border border-outline-variant/30 rounded-2xl p-4 sm:p-5 flex items-center gap-4 hover:border-primary/50 hover:bg-primary-container/10 transition-colors group/guide bg-surface-variant/20">
                <div class="w-14 h-14 rounded-full overflow-hidden shrink-0 bg-gray-100 border-2 border-white shadow-sm">
                    <template x-if="modal.guideAvatar">
                        <img :src="modal.guideAvatar" class="w-full h-full object-cover" />
                    </template>
                    <template x-if="!modal.guideAvatar">
                        <span class="material-symbols-outlined text-3xl text-gray-400 mt-2 block text-center">person</span>
                    </template>
                </div>
                <div class="flex-1">
                    <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Your Local Expert</p>
                    <p class="font-black text-slate-900 text-lg group-hover/guide:text-primary transition-colors" x-text="modal.guideName"></p>
                </div>
                <span class="material-symbols-outlined text-slate-400 group-hover/guide:text-primary transition-colors">arrow_forward</span>
            </a>
            
        </div>

        <!-- Sticky Footer for Price & Book -->
        <div class="border-t border-slate-100 bg-slate-50 p-5 sm:p-6 rounded-b-3xl shrink-0">
            
            <div class="grid grid-cols-2 gap-4 mb-4">
                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Date</label>
                    <input type="text" x-ref="datePicker" x-model="modal.bookingDate" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg focus:outline-none focus:border-primary text-sm font-semibold" placeholder="Select date">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Guests</label>
                    <div class="flex items-center border border-slate-200 rounded-lg bg-white overflow-hidden">
                        <button type="button" @@click="if(modal.bookingGuests > 1) modal.bookingGuests--" class="px-3 py-2 bg-slate-50 hover:bg-slate-100 text-slate-700 font-bold transition-colors">-</button>
                        <input type="number" x-model.number="modal.bookingGuests" class="w-full py-2 text-center focus:outline-none bg-transparent font-bold text-sm" min="1">
                        <button type="button" @@click="modal.bookingGuests++" class="px-3 py-2 bg-slate-50 hover:bg-slate-100 text-slate-700 font-bold transition-colors">+</button>
                    </div>
                </div>
            </div>

            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div>
                    <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Total Price</p>
                    <p class="text-3xl font-black text-primary" x-text="modal.priceLabel"></p>
                </div>
                <button @@click="startTourBooking(modal.id, modal.guideId)"
                        class="bg-primary hover:bg-primary/90 text-white px-8 py-4 rounded-xl font-bold text-lg flex items-center justify-center gap-2 transition-all shadow-lg hover:shadow-xl hover:-translate-y-1 sm:w-auto w-full disabled:opacity-50"
                        :disabled="!modal.bookingDate">
                    <span class="material-symbols-outlined text-[20px]">lock</span>
                    Book This Tour
                </button>
            </div>
        </div>
    </article>
</div>
