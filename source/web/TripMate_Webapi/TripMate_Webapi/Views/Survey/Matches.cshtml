@{
    ViewData["Title"] = "Your Tour Matches";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (ViewBag.PendingQuizJson != null)
{
    <script>
        window.__serverQuizData = @Html.Raw(ViewBag.PendingQuizJson);
    </script>
}

<style>
    [x-cloak] { display: none !important; }
</style>

<main class="min-h-[calc(100vh-72px)] bg-surface px-4 py-8 sm:px-6 lg:py-10" x-data="matchingResults()" x-cloak>
    <div class="mx-auto max-w-6xl">
        <section x-show="isLoading" aria-live="polite">
            <div class="mb-7 rounded-2xl border border-outline-variant/30 bg-white p-6 shadow-sm">
                <div class="h-3 w-28 animate-pulse rounded bg-surface-variant"></div>
                <div class="mt-4 h-9 w-full max-w-lg animate-pulse rounded-lg bg-surface-variant"></div>
                <div class="mt-3 h-4 w-full max-w-2xl animate-pulse rounded bg-surface-variant"></div>
                <div class="mt-5 flex flex-wrap gap-2">
                    <template x-for="item in 4" :key="item">
                        <div class="h-9 w-32 animate-pulse rounded-full bg-surface-variant"></div>
                    </template>
                </div>
            </div>
            <div class="grid gap-5 lg:grid-cols-2">
                <template x-for="item in 4" :key="item">
                    <div class="overflow-hidden rounded-2xl border border-outline-variant/30 bg-white shadow-sm sm:flex">
                        <div class="h-52 animate-pulse bg-surface-variant sm:h-auto sm:w-52"></div>
                        <div class="flex-1 p-5">
                            <div class="h-5 w-3/4 animate-pulse rounded bg-surface-variant"></div>
                            <div class="mt-3 h-3 w-1/2 animate-pulse rounded bg-surface-variant"></div>
                            <div class="mt-6 h-16 animate-pulse rounded-xl bg-surface-variant"></div>
                            <div class="mt-5 h-10 animate-pulse rounded-xl bg-surface-variant"></div>
                        </div>
                    </div>
                </template>
            </div>
            <div class="mt-6 flex items-center justify-center gap-2 text-sm font-medium text-on-surface-variant">
                <span class="material-symbols-outlined animate-spin text-xl text-primary">progress_activity</span>
                Checking live availability and group pricing...
            </div>
        </section>

        <section x-show="hasError && !isLoading" class="mx-auto max-w-xl rounded-2xl border border-outline-variant/30 bg-white p-8 text-center shadow-sm" style="display:none">
            <span class="material-symbols-outlined text-5xl text-on-surface-variant">cloud_off</span>
            <h1 class="mt-4 text-2xl font-extrabold text-on-surface">We could not load your matches</h1>
            <p class="mt-2 text-sm leading-6 text-on-surface-variant" x-text="errorMessage"></p>
            <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row">
                <button type="button" x-on:click="fetchMatches()" class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary px-5 py-3 text-sm font-bold text-white">
                    <span class="material-symbols-outlined text-lg">refresh</span>
                    Try again
                </button>
                <a href="/Survey" class="inline-flex items-center justify-center rounded-xl border border-outline-variant/50 px-5 py-3 text-sm font-bold text-on-surface">Edit preferences</a>
            </div>
        </section>

        <section x-show="!isLoading && !hasError" style="display:none" x-transition.opacity>
            <header class="rounded-2xl border border-outline-variant/30 bg-white p-5 shadow-sm sm:p-7">
                <div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
                    <div>
                        <div class="mb-2 flex items-center gap-2 text-xs font-bold uppercase tracking-[0.16em] text-primary">
                            <span class="material-symbols-outlined text-lg">recommend</span>
                            Smart tour matches
                        </div>
                        <h1 class="text-3xl font-extrabold tracking-tight text-on-surface sm:text-4xl">Your best available options</h1>
                        <p class="mt-2 max-w-2xl text-sm leading-6 text-on-surface-variant sm:text-base">
                            Ranked using your preferences, real group price, tour capacity, and guide availability.
                        </p>
                    </div>
                    <a href="/Survey" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-xl border border-outline-variant/50 px-4 py-2.5 text-sm font-bold text-on-surface transition hover:border-primary hover:text-primary">
                        <span class="material-symbols-outlined text-lg">tune</span>
                        Edit preferences
                    </a>
                </div>

                <div class="mt-6 flex flex-wrap gap-2 border-t border-outline-variant/30 pt-5">
                    <span class="inline-flex items-center gap-2 rounded-full bg-surface-variant px-3 py-2 text-xs font-semibold text-on-surface">
                        <span class="material-symbols-outlined text-base text-primary">location_on</span>
                        <span x-text="destinationLabel"></span>
                    </span>
                    <span class="inline-flex items-center gap-2 rounded-full bg-surface-variant px-3 py-2 text-xs font-semibold text-on-surface">
                        <span class="material-symbols-outlined text-base text-primary">date_range</span>
                        <span x-text="dateLabel"></span>
                    </span>
                    <span class="inline-flex items-center gap-2 rounded-full bg-surface-variant px-3 py-2 text-xs font-semibold text-on-surface">
                        <span class="material-symbols-outlined text-base text-primary">group</span>
                        <span x-text="`${preferences.guests || 1} guest${Number(preferences.guests || 1) === 1 ? '' : 's'}`"></span>
                    </span>
                    <span class="inline-flex items-center gap-2 rounded-full bg-surface-variant px-3 py-2 text-xs font-semibold text-on-surface">
                        <span class="material-symbols-outlined text-base text-primary">interests</span>
                        <span x-text="vibeLabel"></span>
                    </span>
                    <span class="inline-flex items-center gap-2 rounded-full bg-surface-variant px-3 py-2 text-xs font-semibold text-on-surface">
                        <span class="material-symbols-outlined text-base text-primary">payments</span>
                        <span x-text="preferences.budget || 'Any budget'"></span>
                    </span>
                </div>
            </header>

            <div x-show="guides.length === 0" class="mt-6 rounded-2xl border border-outline-variant/30 bg-white px-6 py-14 text-center shadow-sm">
                <span class="material-symbols-outlined text-6xl text-on-surface-variant/60">event_busy</span>
                <h2 class="mt-4 text-2xl font-extrabold text-on-surface">No tour is available for this exact trip</h2>
                <p class="mx-auto mt-2 max-w-lg text-sm leading-6 text-on-surface-variant">Try nearby dates, a smaller group, or another destination. We keep availability as a strict condition so you do not see misleading results.</p>
                <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row">
                    <a href="/Survey" class="rounded-xl bg-primary px-6 py-3 text-sm font-bold text-white">Adjust my trip</a>
                    <a href="/Home/Tours" class="rounded-xl border border-outline-variant/50 px-6 py-3 text-sm font-bold text-on-surface">Browse all tours</a>
                </div>
            </div>

            <div x-show="guides.length > 0" class="mt-7">
                <div class="mb-4 flex items-center justify-between">
                    <div>
                        <h2 class="text-xl font-extrabold text-on-surface">Recommended tours</h2>
                        <p class="mt-1 text-sm text-on-surface-variant"><span class="font-bold text-on-surface" x-text="guides.length"></span> eligible options, highest match first</p>
                    </div>
                    <p class="hidden text-xs text-on-surface-variant sm:block">Match scores rank options; they are not guarantees.</p>
                </div>

                <div class="grid items-stretch gap-5 lg:grid-cols-2">
                    <template x-for="(guide, index) in guides" :key="guide.packageId">
                        <article class="group flex h-full flex-col overflow-hidden rounded-2xl border bg-white shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-md"
                                 :class="index === 0 ? 'border-primary/60 ring-1 ring-primary/20' : 'border-outline-variant/30'">
                            <div class="relative h-52 overflow-hidden bg-surface-variant">
                                <template x-if="guide.coverPhotoUrl">
                                    <img :src="guide.coverPhotoUrl" :alt="guide.packageTitle" class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]">
                                </template>
                                <template x-if="!guide.coverPhotoUrl">
                                    <div class="flex h-full items-center justify-center bg-gradient-to-br from-primary-container to-surface-variant">
                                        <span class="material-symbols-outlined text-6xl text-primary/50">landscape</span>
                                    </div>
                                </template>
                                <div class="absolute inset-0 bg-gradient-to-t from-black/55 via-transparent to-black/10"></div>
                                <span x-show="index === 0" class="absolute left-4 top-4 inline-flex items-center gap-1.5 rounded-full bg-primary px-3 py-1.5 text-xs font-bold text-white shadow-sm">
                                    <span class="material-symbols-outlined text-sm">workspace_premium</span>
                                    Best fit
                                </span>
                                <div class="absolute right-4 top-4 rounded-xl bg-white/95 px-3 py-2 text-right shadow-sm backdrop-blur">
                                    <p class="text-base font-extrabold text-primary" x-text="`${guide.matchScore}/100`"></p>
                                    <p class="text-[10px] font-bold uppercase tracking-wide text-on-surface-variant">Match</p>
                                </div>
                                <div class="absolute bottom-4 left-4 right-4 flex items-end justify-between gap-3 text-white">
                                    <div class="min-w-0">
                                        <p class="flex items-center gap-1 text-xs font-semibold text-white/90">
                                            <span class="material-symbols-outlined text-sm">location_on</span>
                                            <span class="truncate" x-text="guide.cityArea || 'Vietnam'"></span>
                                        </p>
                                        <h3 class="mt-1 line-clamp-2 text-xl font-extrabold leading-tight" x-text="guide.packageTitle"></h3>
                                    </div>
                                    <div class="flex shrink-0 items-center gap-1 rounded-lg bg-black/35 px-2 py-1 text-xs font-bold backdrop-blur">
                                        <span class="material-symbols-outlined text-sm text-amber-300" style="font-variation-settings:'FILL' 1">star</span>
                                        <span x-text="Number(guide.averageRating || 0).toFixed(1)"></span>
                                        <span class="font-normal text-white/70" x-text="`(${guide.totalReviews || 0})`"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="flex flex-1 flex-col p-5">
                                <div class="flex items-center gap-3">
                                    <img :src="guide.avatarUrl || '/images/default_avatar.png'" :alt="guide.name" class="h-9 w-9 rounded-full border border-outline-variant/40 object-cover">
                                    <div class="min-w-0">
                                        <p class="text-xs text-on-surface-variant">Hosted by</p>
                                        <p class="truncate text-sm font-bold text-on-surface" x-text="guide.name"></p>
                                    </div>
                                    <span class="ml-auto rounded-full px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide"
                                          :class="confidenceClass(guide.confidence)"
                                          x-text="`${guide.confidence || 'low'} confidence`"></span>
                                </div>

                                <p class="mt-4 line-clamp-2 min-h-10 text-sm leading-5 text-on-surface-variant" x-text="guide.description || 'A locally hosted experience designed to help you explore the destination.'"></p>

                                <div class="mt-4 grid grid-cols-3 divide-x divide-outline-variant/40 rounded-xl bg-surface-variant/60 px-2 py-3 text-center">
                                    <div class="px-2">
                                        <span class="material-symbols-outlined text-lg text-primary">schedule</span>
                                        <p class="mt-0.5 text-xs font-bold text-on-surface" x-text="durationLabel(guide)"></p>
                                    </div>
                                    <div class="px-2">
                                        <span class="material-symbols-outlined text-lg text-primary">groups</span>
                                        <p class="mt-0.5 text-xs font-bold text-on-surface" x-text="`Up to ${guide.maxGroupSize}`"></p>
                                    </div>
                                    <div class="px-2">
                                        <span class="material-symbols-outlined text-lg text-primary">event_available</span>
                                        <p class="mt-0.5 text-xs font-bold text-on-surface">Available</p>
                                    </div>
                                </div>

                                <div class="mt-4">
                                    <p class="mb-2 text-[11px] font-bold uppercase tracking-wider text-on-surface-variant">Why it fits</p>
                                    <div class="flex flex-wrap gap-2">
                                        <template x-for="(reason, reasonIndex) in (guide.matchReasons || []).slice(0, 3)" :key="`${guide.packageId}-reason-${reasonIndex}`">
                                            <span class="inline-flex items-center gap-1 rounded-full bg-green-50 px-2.5 py-1.5 text-[11px] font-semibold text-green-700">
                                                <span class="material-symbols-outlined text-sm">check_circle</span>
                                                <span x-text="reason"></span>
                                            </span>
                                        </template>
                                    </div>
                                    <template x-if="guide.warnings && guide.warnings.length > 0">
                                        <p class="mt-2 flex items-start gap-1.5 text-xs text-amber-700">
                                            <span class="material-symbols-outlined mt-0.5 text-sm">warning</span>
                                            <span x-text="guide.warnings[0]"></span>
                                        </p>
                                    </template>
                                </div>

                                <div class="mt-auto flex items-end justify-between gap-4 border-t border-outline-variant/30 pt-5">
                                    <div>
                                        <p class="text-xs text-on-surface-variant" x-text="`Estimated for ${preferences.guests || 1} guest${Number(preferences.guests || 1) === 1 ? '' : 's'}`"></p>
                                        <p class="mt-0.5 text-xl font-extrabold text-primary" x-text="formatPrice(guide.estimatedTotal)"></p>
                                        <p class="mt-0.5 text-[10px] text-on-surface-variant" x-text="pricingNote(guide)"></p>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <button type="button" x-on:click="toggleSave(guide)"
                                                :title="isSaved(guide.guideId) ? 'Remove saved guide' : 'Save guide'"
                                                class="flex h-11 w-11 items-center justify-center rounded-xl border transition"
                                                :class="isSaved(guide.guideId) ? 'border-red-200 bg-red-50 text-red-500' : 'border-outline-variant/50 text-on-surface-variant hover:border-primary hover:text-primary'">
                                            <span class="material-symbols-outlined" :style="isSaved(guide.guideId) ? 'font-variation-settings: FILL 1' : ''">favorite</span>
                                        </button>
                                        <a :href="`/Traveler/GuideProfile/${guide.guideId}`" class="inline-flex h-11 items-center gap-2 rounded-xl bg-primary px-4 text-sm font-bold text-white transition hover:bg-primary/90">
                                            View tour
                                            <span class="material-symbols-outlined text-lg">arrow_forward</span>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </article>
                    </template>
                </div>
            </div>
        </section>
    </div>
</main>

<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('matchingResults', () => ({
            isLoading: true,
            hasError: false,
            errorMessage: '',
            guides: [],
            savedIds: [],
            preferences: {
                destination: 'Vietnam',
                customDestination: '',
                vibe: '',
                customVibe: '',
                budget: '',
                dateRange: '',
                guests: 1
            },

            init() {
                try {
                    const savedGuides = JSON.parse(localStorage.getItem('savedGuides') || '[]');
                    this.savedIds = Array.isArray(savedGuides) ? savedGuides.map(item => item.guideId) : [];

                    const storedPreferences = JSON.parse(localStorage.getItem('tripPreferences') || 'null');
                    if (storedPreferences) this.preferences = { ...this.preferences, ...storedPreferences };
                    if (window.__serverQuizData) {
                        this.preferences = { ...this.preferences, ...window.__serverQuizData };
                        localStorage.setItem('tripPreferences', JSON.stringify(this.preferences));
                    }
                } catch (error) {
                    console.warn('[Smart Matching] Could not restore local state.', error);
                }

                this.fetchMatches();
            },

            get destinationLabel() {
                return this.preferences.destination === 'Other'
                    ? (this.preferences.customDestination || 'Other destination')
                    : (this.preferences.destination || 'Vietnam');
            },

            get vibeLabel() {
                return this.preferences.vibe === 'Other'
                    ? (this.preferences.customVibe || 'Custom experience')
                    : (this.preferences.vibe || 'Any style');
            },

            get dateLabel() {
                const dates = this.parseDateRange(this.preferences.dateRange);
                if (!dates.startDate) return 'Flexible dates';
                if (dates.startDate === dates.endDate) return this.formatDate(dates.startDate);
                return `${this.formatDate(dates.startDate)} – ${this.formatDate(dates.endDate)}`;
            },

            async fetchMatches() {
                this.isLoading = true;
                this.hasError = false;

                try {
                    const dates = this.parseDateRange(this.preferences.dateRange);
                    const response = await fetch('/Survey/CalculateMatches', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            destination: this.destinationLabel,
                            vibe: this.vibeLabel,
                            budgetTier: this.preferences.budget || '',
                            startDate: dates.startDate,
                            endDate: dates.endDate,
                            guestCount: Math.max(1, Number(this.preferences.guests) || 1),
                            interests: [],
                            preferredLanguages: [],
                            limit: 6
                        })
                    });

                    const data = await response.json().catch(() => null);
                    if (!response.ok || !data?.success) {
                        throw new Error(data?.message || `Server error: ${response.status}`);
                    }
                    this.guides = data.matches || [];
                } catch (error) {
                    console.error('[Smart Matching] Error:', error);
                    this.hasError = true;
                    this.errorMessage = 'Check your connection, then try again. Your trip preferences are still saved.';
                } finally {
                    this.isLoading = false;
                }
            },

            parseDateRange(value) {
                const parts = String(value || '').split(' to ').map(item => item.trim()).filter(Boolean);
                return {
                    startDate: parts[0] || null,
                    endDate: parts[1] || parts[0] || null
                };
            },

            formatDate(value) {
                const date = new Date(`${value}T00:00:00`);
                if (Number.isNaN(date.getTime())) return value;
                return new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short' }).format(date);
            },

            formatPrice(value) {
                return new Intl.NumberFormat('vi-VN', {
                    style: 'currency',
                    currency: 'VND',
                    maximumFractionDigits: 0
                }).format(Number(value) || 0);
            },

            durationLabel(guide) {
                const days = Math.max(1, Number(guide.durationDays) || 1);
                if (days > 1) return `${days} days`;
                const minutes = Math.max(0, Number(guide.durationMinutes) || 0);
                if (!minutes) return 'Same day';
                if (minutes % 60 === 0) return `${minutes / 60} hours`;
                return `${Math.floor(minutes / 60)}h ${minutes % 60}m`;
            },

            pricingNote(guide) {
                const included = Math.max(1, Number(guide.includedGuestCount) || 1);
                const extra = Number(guide.additionalGuestFee) || 0;
                if (extra > 0) return `Includes ${included}; ${this.formatPrice(extra)} per extra guest`;
                return `Includes up to ${included} guest${included === 1 ? '' : 's'}`;
            },

            confidenceClass(value) {
                if (value === 'high') return 'bg-green-50 text-green-700';
                if (value === 'medium') return 'bg-amber-50 text-amber-700';
                return 'bg-surface-variant text-on-surface-variant';
            },

            isSaved(guideId) {
                return this.savedIds.includes(guideId);
            },

            toggleSave(guide) {
                let list = [];
                try {
                    const parsed = JSON.parse(localStorage.getItem('savedGuides') || '[]');
                    list = Array.isArray(parsed) ? parsed : [];
                } catch { }

                if (this.isSaved(guide.guideId)) {
                    list = list.filter(item => item.guideId !== guide.guideId);
                    this.savedIds = this.savedIds.filter(id => id !== guide.guideId);
                } else {
                    list.push({
                        guideId: guide.guideId,
                        name: guide.name,
                        coverPhotoUrl: guide.coverPhotoUrl || '',
                        avatarUrl: guide.avatarUrl || '',
                        cityArea: guide.cityArea || '',
                        specialties: guide.specialties || [],
                        averageRating: guide.averageRating || 0,
                        totalReviews: guide.totalReviews || 0,
                        savedAt: new Date().toISOString()
                    });
                    this.savedIds = [...this.savedIds, guide.guideId];
                }

                localStorage.setItem('savedGuides', JSON.stringify(list));
            }
        }));
    });
</script>
