@model List<TripMate_WebAPI.Services.ExperiencePackageRow>
@{
    ViewData["Title"] = "Browse Tours — TripMate";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string? searchQuery = ViewBag.Search as string;
    string? destQuery = ViewBag.Destination as string;
    bool hasSearch = !string.IsNullOrEmpty(searchQuery) || !string.IsNullOrEmpty(destQuery);
}

<div class="bg-surface min-h-screen" x-data="toursBrowse()">

    <!-- Hero Header -->
    <div class="bg-gradient-to-br from-primary via-primary/90 to-orange-500 pt-12 pb-16 px-6 md:px-12 relative overflow-hidden">
        <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1528127269322-539801943592?w=1920')] bg-cover bg-center opacity-15"></div>
        <div class="max-w-[1440px] mx-auto relative z-10">
            <a href="javascript:history.back()" class="inline-flex items-center text-white/80 hover:text-white font-bold mb-6 transition-colors text-sm">
                <span class="material-symbols-outlined mr-1 text-[18px]">arrow_back</span> Back
            </a>
            @if (hasSearch)
            {
                <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-3">
                    Tours in <span class="text-yellow-200">@(searchQuery ?? destQuery)</span>
                </h1>
                <p class="text-white/80 text-lg">@Model.Count tours found for your destination.</p>
            }
            else
            {
                <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-3">Explore All Tours</h1>
                <p class="text-white/80 text-lg">Handcrafted experiences by verified local guides.</p>
            }

        </div>
    </div>

    <!-- Filter Tags -->
    <div class="max-w-[1440px] mx-auto px-6 md:px-12 mt-8 mb-6">
        <div class="flex flex-wrap gap-3">
            <a href="/Home/Tours" class="px-4 py-2 rounded-full @(!hasSearch ? "bg-primary text-white" : "bg-white border border-outline-variant/30 text-on-surface-variant hover:bg-surface-variant") font-bold text-sm shadow-sm transition-colors">All Tours</a>
            <a href="/Home/Tours?destination=Ha Long" class="px-4 py-2 rounded-full @(destQuery?.Contains("Ha Long") == true ? "bg-primary text-white" : "bg-white border border-outline-variant/30 text-on-surface-variant hover:bg-surface-variant") font-bold text-sm shadow-sm transition-colors">Ha Long Bay</a>
            <a href="/Home/Tours?destination=Hoi An" class="px-4 py-2 rounded-full @(destQuery?.Contains("Hoi An") == true ? "bg-primary text-white" : "bg-white border border-outline-variant/30 text-on-surface-variant hover:bg-surface-variant") font-bold text-sm shadow-sm transition-colors">Hoi An</a>
            <a href="/Home/Tours?destination=Da Nang" class="px-4 py-2 rounded-full @(destQuery?.Contains("Da Nang") == true ? "bg-primary text-white" : "bg-white border border-outline-variant/30 text-on-surface-variant hover:bg-surface-variant") font-bold text-sm shadow-sm transition-colors">Da Nang</a>
            <a href="/Home/Tours?destination=Sapa" class="px-4 py-2 rounded-full @(destQuery?.Contains("Sapa") == true ? "bg-primary text-white" : "bg-white border border-outline-variant/30 text-on-surface-variant hover:bg-surface-variant") font-bold text-sm shadow-sm transition-colors">Sapa</a>
            <a href="/Home/Tours?destination=Phu Quoc" class="px-4 py-2 rounded-full @(destQuery?.Contains("Phu Quoc") == true ? "bg-primary text-white" : "bg-white border border-outline-variant/30 text-on-surface-variant hover:bg-surface-variant") font-bold text-sm shadow-sm transition-colors">Phu Quoc</a>
        </div>
        
        <!-- Advanced Filters Form -->
        <form method="get" action="/Home/Tours" class="mt-6 bg-white p-6 rounded-2xl shadow-sm border border-outline-variant/30">
            @if (!string.IsNullOrEmpty(searchQuery))
            {
                <input type="hidden" name="search" value="@searchQuery" />
            }
            @if (!string.IsNullOrEmpty(destQuery))
            {
                <input type="hidden" name="destination" value="@destQuery" />
            }
            
            <div class="flex items-center justify-between mb-4">
                <h3 class="font-bold text-on-surface flex items-center gap-2"><span class="material-symbols-outlined text-primary text-xl">tune</span> Advanced Filters</h3>
                <button type="button" @@click="showFilters = !showFilters" class="text-sm font-bold text-primary hover:underline" x-text="showFilters ? 'Hide Filters' : 'Show Filters'">Show Filters</button>
            </div>

            <div x-show="showFilters" x-collapse x-cloak>
                <div class="grid grid-cols-1 md:grid-cols-4 gap-6 pt-2">
                    <div>
                        <label class="block text-xs font-bold text-on-surface-variant uppercase mb-2">Price Range (VND)</label>
                        <div class="flex items-center gap-2">
                            <input type="number" name="minPrice" placeholder="Min" value="@ViewBag.MinPrice" class="w-full px-3 py-2 bg-surface-variant/50 border border-outline-variant/30 rounded-lg text-sm focus:outline-none focus:border-primary">
                            <span class="text-on-surface-variant">-</span>
                            <input type="number" name="maxPrice" placeholder="Max" value="@ViewBag.MaxPrice" class="w-full px-3 py-2 bg-surface-variant/50 border border-outline-variant/30 rounded-lg text-sm focus:outline-none focus:border-primary">
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-on-surface-variant uppercase mb-2">Duration (Hours)</label>
                        <div class="flex items-center gap-2">
                            <input type="number" name="minDuration" placeholder="Min" value="@ViewBag.MinDuration" class="w-full px-3 py-2 bg-surface-variant/50 border border-outline-variant/30 rounded-lg text-sm focus:outline-none focus:border-primary">
                            <span class="text-on-surface-variant">-</span>
                            <input type="number" name="maxDuration" placeholder="Max" value="@ViewBag.MaxDuration" class="w-full px-3 py-2 bg-surface-variant/50 border border-outline-variant/30 rounded-lg text-sm focus:outline-none focus:border-primary">
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-on-surface-variant uppercase mb-2">Group Size</label>
                        <input type="number" name="minGroupSize" placeholder="Min people" value="@ViewBag.MinGroupSize" class="w-full px-3 py-2 bg-surface-variant/50 border border-outline-variant/30 rounded-lg text-sm focus:outline-none focus:border-primary">
                    </div>
                    <div class="flex items-end">
                        <button type="submit" class="w-full bg-primary hover:bg-primary/90 text-white font-bold py-2 rounded-lg transition-colors flex items-center justify-center gap-2">
                            <span class="material-symbols-outlined text-[18px]">filter_list</span> Apply Filters
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>

    <!-- Tours Grid -->
    <div class="max-w-[1440px] mx-auto px-6 md:px-12 pb-20">
        @if (Model != null && Model.Any())
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                @foreach (var tour in Model)
                {
                    var guideName = tour.GuideProfile?.Profile?.FullName ?? "Local Guide";
                    var guideCityArea = tour.GuideProfile?.CityArea ?? "Vietnam";
                    var tourCover = tour.CoverImageUrl ?? "";
                    var guideAvatar = tour.GuideProfile?.Profile?.AvatarUrl ?? "";
                    var guideId = tour.GuideProfileId ?? "";
                    var priceLabel = tour.PricePerSession > 0
                        ? string.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:C0}", tour.PricePerSession) + "/session"
                        : (tour.PricePerPerson > 0 ? string.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:C0}", tour.PricePerPerson) + "/person" : "Contact");
                    var timelineStr = tour.TimelineJson != null ? System.Text.Json.JsonSerializer.Serialize(tour.TimelineJson) : "[]";

                    <div class="bg-white rounded-3xl overflow-hidden shadow-sm border border-outline-variant/30 group hover:shadow-xl hover:-translate-y-2 transition-all duration-300 cursor-pointer flex flex-col"
                         @@click="openTourModal('@System.Web.HttpUtility.JavaScriptStringEncode(tour.Id ?? "")', '@System.Web.HttpUtility.JavaScriptStringEncode(tour.Title ?? "")', `@System.Web.HttpUtility.JavaScriptStringEncode(tour.Description ?? "")`, @tour.DurationHours, @tour.PricePerSession, @(tour.PricePerPerson ?? 0), @tour.MaxGroupSize, '@System.Web.HttpUtility.JavaScriptStringEncode(string.Join(",", tour.IncludedItems ?? new List<string>()))', '@System.Web.HttpUtility.JavaScriptStringEncode(guideName)', '@System.Web.HttpUtility.JavaScriptStringEncode(guideAvatar)', '@System.Web.HttpUtility.JavaScriptStringEncode(guideId)', '@System.Web.HttpUtility.JavaScriptStringEncode(tourCover)', '@System.Web.HttpUtility.JavaScriptStringEncode(guideCityArea)', '@System.Web.HttpUtility.JavaScriptStringEncode(timelineStr)')">
                    var tourModalPayload = System.Text.Json.JsonSerializer.Serialize(new
                    {
                        id = tour.Id ?? "",
                        title = tour.Title ?? "",
                        description = tour.Description ?? "",
                        duration = tour.DurationHours,
                        pricePerSession = tour.PricePerSession,
                        pricePerPerson = tour.PricePerPerson ?? 0,
                        includedGuestCount = tour.IncludedGuestCount,
                        maxGroup = tour.MaxGroupSize,
                        includedItems = tour.IncludedItems ?? new List<string>(),
                        guideName,
                        guideAvatar,
                        guideId
                    });

                    <div class="bg-white rounded-3xl overflow-hidden shadow-sm border border-outline-variant/30 group hover:shadow-xl hover:-translate-y-2 transition-all duration-300 cursor-pointer flex flex-col"
                         data-tour-modal="@tourModalPayload"
                         @@click="openTourModal(JSON.parse($event.currentTarget.dataset.tourModal))">
                        <!-- Cover Image -->
                        <div class="h-52 relative overflow-hidden bg-gray-100">
                            @if (!string.IsNullOrEmpty(tourCover))
                            {
                                <img src="@tourCover" alt="@tour.Title" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
                            }
                            else
                            {
                                <div class="w-full h-full bg-gradient-to-br from-primary-container to-surface-variant flex items-center justify-center">
                                    <span class="material-symbols-outlined text-6xl text-primary/30">landscape</span>
                                </div>
                            }
                            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
                            <!-- Duration Badge -->
                            <div class="absolute top-4 right-4 bg-white/90 backdrop-blur-sm px-3 py-1 rounded-full text-xs font-bold text-primary flex items-center gap-1 shadow-sm">
                                <span class="material-symbols-outlined text-[14px]">schedule</span> @tour.DurationHours hrs
                            </div>
                            <!-- Guide Avatar -->
                            <div class="absolute bottom-4 left-4 flex items-center gap-3 z-10">
                                <div class="w-10 h-10 rounded-full border-2 border-white overflow-hidden shadow-md bg-gray-200">
                                    @if (!string.IsNullOrEmpty(guideAvatar))
                                    {
                                        <img src="@guideAvatar" class="w-full h-full object-cover" />
                                    }
                                    else
                                    {
                                        <span class="material-symbols-outlined text-xl text-gray-400 mt-1 block text-center">person</span>
                                    }
                                </div>
                                <div>
                                    <p class="text-white text-sm font-bold drop-shadow">@guideName</p>
                                    <p class="text-white/80 text-xs flex items-center gap-0.5"><span class="material-symbols-outlined text-[12px]">location_on</span> @guideCityArea</p>
                                </div>
                            </div>
                        </div>

                        <!-- Card Content -->
                        <div class="p-6 flex-1 flex flex-col">
                            <h3 class="text-xl font-bold text-on-surface mb-2 group-hover:text-primary transition-colors">@tour.Title</h3>
                            <p class="text-on-surface-variant text-sm line-clamp-2 mb-4">@tour.Description</p>

                            @if (tour.Tags != null && tour.Tags.Any())
                            {
                                <div class="flex flex-wrap gap-1 mb-4">
                                    @foreach (var tag in tour.Tags.Take(3))
                                    {
                                        <span class="px-2 py-1 bg-surface-variant text-on-surface-variant text-[10px] rounded font-bold uppercase tracking-wider">@tag</span>
                                    }
                                </div>
                            }

                            <div class="mt-auto flex items-center justify-between pt-4 border-t border-outline-variant/20">
                                <div>
                                    <p class="text-xs text-on-surface-variant">From</p>
                                    <p class="text-xl font-bold text-primary">@priceLabel</p>
                                </div>
                                <span class="bg-primary/10 text-primary px-4 py-2 rounded-lg font-bold text-sm group-hover:bg-primary group-hover:text-white transition-all flex items-center gap-1">
                                    View Details <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
                                </span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-20">
                <span class="material-symbols-outlined text-6xl text-on-surface-variant/50 mb-4">search_off</span>
                <h3 class="text-2xl font-bold text-on-surface mb-2">No tours found</h3>
                <p class="text-on-surface-variant mb-6">Try adjusting your search or explore other destinations.</p>
                <a href="/Home/Tours" class="bg-primary text-white px-6 py-3 rounded-xl font-bold hover:bg-primary/90 transition-colors inline-block">Browse All Tours</a>
            </div>
        }
    </div>

    <!-- ═══ Tour Detail Modal ═══ -->
    <partial name="_TravelerTourModal" />
</div>

<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('toursBrowse', () => ({
            showFilters: false,
            showModal: false,
            bookingInProgress: false,
            showWizard: false,
            wizardStep: 1,
            bookingPackageId: '',
            bookingDate: new Date(Date.now() + 7 * 86400000).toISOString().split('T')[0],
            bookingGuests: 1,
            bookingNotes: '',
            selectedMethod: 'Credit Card',
            
            get computedTotal() {
                const included = Math.max(1, this.modal.includedGuestCount);
                const guests = Math.max(1, Number(this.bookingGuests) || 1);
                const extraGuests = Math.max(0, guests - included);
                return Math.max(0, this.modal.pricePerSession)
                    + extraGuests * Math.max(0, this.modal.pricePerPerson);
            },
            get platformFee() {
                return Math.round(this.computedTotal * 0.15);
            },
            get guideEarnings() {
                return this.computedTotal - this.platformFee;
            },
            
            paymentInProgress: false,
            modal: {
                id: '', title: '', description: '', duration: 0,
                pricePerSession: 0, pricePerPerson: 0, includedGuestCount: 1, maxGroup: 6,
                includedItems: [], priceLabel: '',
                guideName: '', guideAvatar: '', guideId: '',
                coverImageUrl: '', cityArea: '', timeline: [],
                bookingDate: '', bookingGuests: 1
            },

            openTourModal(id, title, description, duration, pricePerSession, pricePerPerson, maxGroup, includedItemsStr, guideName, guideAvatar, guideId, coverImageUrl, cityArea, timelineJsonStr) {
                this.modal.id = id;
                this.modal.title = title;
                this.modal.description = description;
                this.modal.duration = duration;
                this.modal.pricePerSession = pricePerSession;
                this.modal.pricePerPerson = pricePerPerson;
                this.modal.maxGroup = maxGroup;
                this.modal.includedItems = includedItemsStr ? includedItemsStr.split(',').map(s => s.trim()).filter(s => s) : [];
                this.modal.guideName = guideName || 'Local Guide';
                this.modal.guideAvatar = guideAvatar || '';
                this.modal.guideId = guideId || '';
                this.modal.coverImageUrl = coverImageUrl || '';
                this.modal.cityArea = cityArea || '';
                try {
                    this.modal.timeline = JSON.parse(timelineJsonStr || '[]');
                } catch(e) {
                    this.modal.timeline = [];
                }
            openTourModal(tour) {
                const pricePerSession = Number(tour?.pricePerSession) || 0;
                const pricePerPerson = Number(tour?.pricePerPerson) || 0;
                this.modal.id = tour?.id || '';
                this.modal.title = tour?.title || '';
                this.modal.description = tour?.description || '';
                this.modal.duration = Number(tour?.duration) || 0;
                this.modal.pricePerSession = pricePerSession;
                this.modal.pricePerPerson = pricePerPerson;
                this.modal.includedGuestCount = Math.max(1, Number(tour?.includedGuestCount) || 1);
                this.modal.maxGroup = Number(tour?.maxGroup) || 1;
                this.modal.includedItems = Array.isArray(tour?.includedItems)
                    ? tour.includedItems.filter(item => typeof item === 'string' && item.trim())
                    : [];
                this.modal.guideName = tour?.guideName || 'Local Guide';
                this.modal.guideAvatar = tour?.guideAvatar || '';
                this.modal.guideId = tour?.guideId || '';

                const fmt = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND', maximumFractionDigits: 0 });
                this.modal.priceLabel = pricePerSession > 0
                    ? fmt.format(pricePerSession) + '/tour'
                    : 'Contact';

                this.modal.bookingDate = '';
                this.modal.bookingGuests = 1;
                this.showModal = true;

                // Fetch blocked dates and init flatpickr
                fetch(`/Traveler/GetGuideAvailability?guideId=${guideId}`)
                    .then(r => r.json())
                    .then(blockedDates => {
                        if(this._fp) this._fp.destroy();
                        this.$nextTick(() => {
                            this._fp = flatpickr(this.$refs.datePicker, {
                                minDate: "today",
                                disable: blockedDates,
                                onChange: (selectedDates, dateStr) => {
                                    this.modal.bookingDate = dateStr;
                                }
                            });
                        });
                    }).catch(err => console.error('Error fetching availability', err));
            },

            async startTourBooking(packageId, guideId) {
                const token = localStorage.getItem('accessToken');
                if (!token) {
                    window.location.href = '/Auth/Login?returnUrl=' + encodeURIComponent(window.location.pathname);
                    return;
                }
                if (this.bookingInProgress) return;
                this.bookingInProgress = true;

                try {
                    const formData = new FormData();
                    formData.append('guideId', guideId);
                    formData.append('packageId', packageId);
                    formData.append('date', this.modal.bookingDate);
                    formData.append('guests', this.modal.bookingGuests.toString());
                    
                    const res = await fetch('/Traveler/BookTour', {
                        method: 'POST',
                        headers: { 'Authorization': 'Bearer ' + token },
                        body: formData
                    });

                    if (res.ok) {
                        const data = await res.json();
                        if (data.paymentUrl) {
                            window.location.href = data.paymentUrl;
                            return;
                        }
                    } else if (res.status === 400) {
                        const errorData = await res.json();
                        Swal.fire({ title: 'Notice', text: errorData.error || 'Booking failed.', icon: 'info' });
                    } else {
                        Swal.fire({ title: 'Error', text: 'Booking failed. Please try again.', icon: 'error' });
                    }
                } catch(err) {
                    console.error('Booking error:', err);
                    Swal.fire('Error', 'Connection error. Please try again.', 'error');
                } finally {
                    this.bookingInProgress = false;
                }
            }
        }))
    })
</script>
